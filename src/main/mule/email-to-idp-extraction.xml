<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:os="http://www.mulesoft.org/schema/mule/os" xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd">
	<sub-flow name="read-attachments" doc:id="f54f4c76-d303-4c06-ab76-574b8e9f238e" >
		<set-variable value="#[payload.id]" doc:name="mailId" doc:id="4ee3a903-972b-445d-8112-bf36ea2bc608" variableName="mailId" />
		<http:request method="GET" doc:name="read attachments in each mail" doc:id="76ceb06a-4ec7-4ad1-a213-ecb9df80bcca" config-ref="HTTP_Graph_API_configuration" path="#[&quot;/v1.0/users/&quot; ++ p('graphApi.emailId') ++ &quot;/mailFolders/&quot; ++ p('mail.inventory.folderId') ++ &quot;/messages/&quot; ++ vars.mailId ++ &quot;/attachments&quot;]" >
			<http:headers ><![CDATA[#[output application/java
---
{
	"Authorization" : "Bearer" ++ vars.token
}]]]></http:headers>
		</http:request>
		<set-variable value='#[(payload.value filter ((e) -&gt; e.name contains(".pdf")))&#10;map ((doc) -&gt; doc.name)]' doc:name="allPDFs" doc:id="9675230f-4d1e-45fa-9d40-461cb51a92c7" variableName="allPDFs"/>
		<logger level="INFO" doc:name="LIST OF PDFs IN EMAIL" doc:id="770401c4-6428-4516-a3c6-272135ec27e4" message='#["[INVENTORY] :: LIST OF PDFs IN EMAIL :: " ++ write(vars.allPDFs, "application/json")]'/>
		<flow-ref doc:name="check-required-pdf-attachment-in-email" doc:id="76b9b56b-4dea-427a-a985-4e36742760f0" name="check-required-pdf-attachment-in-email" />
		<foreach doc:name="For Each attachment" doc:id="8bf3e9e2-05b8-4345-a365-24c72fc698ad" collection="#[payload.value]" >
			<set-variable value="#[payload.name]" doc:name="pdfName" doc:id="75354728-83a7-4905-9a05-c781a00a9844" variableName="pdfName" />
			<ee:transform doc:name="pdf-binary" doc:id="c7c74d75-3a40-43c6-8ba0-03199924fb2f" >
				<ee:message >
					<ee:set-payload ><![CDATA[%dw 2.0
output application/java
import dw::core::Binaries
---
Binaries::fromBase64(payload.contentBytes)]]></ee:set-payload>
				</ee:message>
				<ee:variables >
					<ee:set-variable variableName="pdfName" ><![CDATA[payload.name]]></ee:set-variable>
				</ee:variables>
			</ee:transform>
			<ee:transform doc:name="idp request data" doc:id="148a563a-9095-460c-97b4-ff7ae78005e3" >
				<ee:message >
					<ee:set-payload ><![CDATA[%dw 2.0
output multipart/form-data
---
{
    parts : {
        file : {
            headers : {
                "Content-Disposition" : {
                    "name": "file",
                    "filename": vars.pdfName
                    },
                "Content-Type" : "application/pdf"
                },
            content : payload
            }
        }
}]]></ee:set-payload>
				</ee:message>
			</ee:transform>
			<flow-ref doc:name="idp-routing-subflow" doc:id="8882df2c-8af3-48a6-b7ba-a66af7b80fe7" name="idp-routing-subflow" />
		</foreach>
		<ee:transform doc:name="var completeSet" doc:id="d64a0c33-457d-45c3-a17f-66c76381e85f" >
			<ee:message />
			<ee:variables >
				<ee:set-variable variableName="completeSet" ><![CDATA[%dw 2.0
output application/json
---
vars.inventoryDate map (item, index) -> {
    Date: item,
    Elmendorf: vars.elmendorfIdpResponse[item],
    "TSAR": vars."tsarIdpResponse"[item],
	"TMS6": vars."tms6Data"[item],
    Freepoint: vars.freepointIdpResponse
}
]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<ee:transform doc:name="reordering the completeSet" doc:id="6b192562-3f01-4c3e-adaa-c1bcb556aca3" >
			<ee:message />
			<ee:variables >
				<ee:set-variable variableName="completeSet" ><![CDATA[%dw 2.0
output application/json
import * from dw::core::Dates
---
vars.completeSet
  orderBy (item) ->
    (item.Date as Date { format: "d-MMM-yyyy" })
]]></ee:set-variable>
				<ee:set-variable variableName="compltFreepointIdpResponse" ><![CDATA[%dw 2.0
output application/json
import * from dw::core::Dates
---
vars.compltFreepointIdpResponse
  orderBy (item) ->
    (item."Inventory Date" as Date { format: "d-MMM-yyyy" })
]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<logger level="INFO" doc:name="Logger" doc:id="72ed7e7d-5db3-410b-9390-96a7aa487a9a" message="#[vars.completeSet]" />
		<foreach doc:name="For Each completeSet (for each day)" doc:id="4a492d11-f9c3-40d3-8409-b8c70ac0db96" collection="#[vars.completeSet]" >
			<ee:transform doc:name="idpResponseData or eachDayData" doc:id="5c0ac444-0a06-4ee4-9965-0045138aad91" >
				<ee:message />
				<ee:variables >
					<ee:set-variable variableName="inventoryDate" ><![CDATA[payload.Date]]></ee:set-variable>
					<ee:set-variable variableName="idpResponseData" ><![CDATA[%dw 2.0
output application/json
---
{	"Date": payload.Date,
	"Elmendorf": payload.Elmendorf,
	"TSAR": payload.TSAR,
	"TMS6": payload.TMS6,
	"Freepoint": payload.Freepoint
}]]></ee:set-variable>
				</ee:variables>
			</ee:transform>
			<flow-ref doc:name="idp-to-inventory-sub-flow" doc:id="8ed5ee19-94ca-4fbd-8a13-13c69a9a8203" name="idp-to-inventory-sub-flow" />
		</foreach>
	</sub-flow>
	<sub-flow name="idp-routing-subflow" doc:id="52e0406b-4c91-496d-8ec2-5a4a9a396997" >
		<choice doc:name="routing pdfs to respective idp" doc:id="4edb50b9-6e4c-4b53-abbf-6332905f16cd" >
			<when expression='#[lower(vars."pdfName") contains("product summary")]' >
				<flow-ref doc:name="tms6-idp-extraction-subflow" doc:id="10220f3f-a91f-4045-8331-c1e0f204cf9f" name="tms6-idp-extraction-subflow" />
			</when>
			<when expression='#[(lower(vars."pdfName") contains "elmendorf") or (lower(vars."pdfName") contains "san antonio")]' >
				<flow-ref doc:name="tis-idp-extraction-subflow" doc:id="0d808090-1cdf-4776-bf0a-b874e1d3353e" name="tis-idp-extraction-subflow" />
			</when>
			<otherwise >
				<logger level="INFO" doc:name="Logger" doc:id="5441c0ec-c032-4291-abf1-026653e92021" />
			</otherwise>
		</choice>
	</sub-flow>
	<sub-flow name="check-required-pdf-attachment-in-email" doc:id="34cc8f49-d10a-45d9-b843-3439d4e1fe5f" >
		<ee:transform doc:name="check doc names" doc:id="f77d6e7d-4f09-46f3-a7b5-3268a54aed62" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="checkDocNames" ><![CDATA[%dw 2.0
output application/json

var documentNames =  payload.value.name

var requiredDocs = [
  "Product Summary Report",
  "Elmendorf Ending Inventory",
  "San Antonio Ending Inventory"
]

// Filter only files starting with YYYY_MM_DD or YYYY.MM.DD
var datedDocs =
  documentNames filter (d) ->
    sizeOf(d) > 10 and
    (d[4] == "_" or d[4] == ".") and
    (d[7] == "_" or d[7] == ".")

// Normalize date to YYYY-MM-DD
var normalizeDate = (dt) ->
  (dt replace "_" with "-") replace "." with "-"

// Get unique normalized dates
var uniqueDates =
  (datedDocs map (d) -> normalizeDate(d[0 to 9])) distinctBy $

// Build final result
var result =
  uniqueDates map (dt) -> do {

    var docsForDate =
      datedDocs filter (d) ->
        normalizeDate(d[0 to 9]) == dt

    var docNames =
      docsForDate map (d) -> d[11 to -5]

    // Bidirectional contains logic (safe version)
    var missing =
      requiredDocs filter (req) ->
        isEmpty(
          docNames filter (doc) ->
            (
              upper(doc) contains upper(req)
            )
            or
            (
              upper(req) contains upper(doc)
            )
        )

    ---
    {
      date: dt,
      status: isEmpty(missing),
      missingDocuments: missing
    }
  }

---
result
]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<ee:transform doc:name="missingDocNames" doc:id="d7263b83-eb48-4d85-aeff-be151790067a" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="missingDocNames" ><![CDATA[%dw 2.0
output application/json

var failed = vars.checkDocNames filter ($.status == false)

---
failed flatMap (
  (item) ->
    item.missingDocuments map (
      (doc) ->
        item.date ++ " - " ++ doc
    )
)
]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<foreach doc:name="For Each" doc:id="9a31a45d-68d2-4274-85a1-39be89141972" collection="#[vars.checkDocNames]">
			<choice doc:name="Choice" doc:id="add74412-44bf-40d0-b991-36eb347c208f">
			<when expression="#[isEmpty(vars.missingDocNames) == true]">
					<logger level="INFO" doc:name="Logger" doc:id="df63c687-e1a8-4027-85ba-84f6ea30a157" message='"All the document names are present"'/>
				</when>
				<otherwise >
					<set-variable value='#[%dw 2.0&#10;output application/json&#10;---&#10;"Missing Documents are : " ++ (vars.missingDocNames joinBy ", ")]' doc:name="missingDocMessage" doc:id="a1076790-d6f6-4fa9-9ec9-8f039d08cda9" variableName="missingDocMessage"/>
					<logger level="INFO" doc:name="Logger" doc:id="2ded2f0f-1bdb-4b7e-9e4a-608038c17252" message='#[vars.missingDocMessage]'/>
					<raise-error doc:name="Raise error" doc:id="d7a0cd68-9a78-4237-8c18-a07dee530404" type="CUSTOM:MISSING_DOCUMENTS" description="#[vars.missing]"/>
				</otherwise>
		</choice>
		</foreach>
	</sub-flow>
</mule>
