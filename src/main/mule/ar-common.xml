			<ee:message />
			<ee:variables >
				<ee:set-variable variableName="numberToColumn" ><![CDATA[%dw 2.0
output application/json
var columnCount= vars."columnCount"
var nextColumnCount= columnCount + 1
var preColumnCount = columnCount - 1
var letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

fun toExcelColumn(n) =
    if (n <= 0) "" 
    else do {
        var rem = (n - 1) mod 26
        var quotient = floor((n - 1) / 26)
        ---
        toExcelColumn(quotient) ++ letters[(rem) as Number]
    }

---
{ 
  Number: columnCount,
  CurrentColumn: toExcelColumn(columnCount),
  NextColumn: toExcelColumn(nextColumnCount),
  PreviousColumn: toExcelColumn(preColumnCount),
}
]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
