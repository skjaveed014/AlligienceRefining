	<sub-flow name="get-columnCountAndColumns-of-inventory-subflow" doc:id="63fbb482-aa57-4e4a-a86f-52f918e5230e" >
		<http:request method="GET" doc:name="gets inventoryColumnCount" doc:id="73c32de1-f156-4b89-9940-c33a7adc8cb5" config-ref="HTTP_Graph_API_configuration" path="#[&quot;/v1.0/users/&quot; ++ p('graphApi.emailId') ++ &quot;/drive/items/&quot; ++ vars.inventoryAndSalesWorkbookId ++ &quot;/workbook/tables/&quot; ++ p('inventory.tableName') ++&quot;/columns/count&quot;]" target="inventoryColumnCount" targetValue="#[payload.value]">
			<http:body ><![CDATA[#[""]]]></http:body>
			<http:headers ><![CDATA[#[output application/json
---
{
	"Authorization" : "Bearer "++ vars."token" as String
}]]]></http:headers>
		</http:request>
		<ee:transform doc:name="columnCountAndExcelColumn" doc:id="4950c158-7252-4b8b-860e-032b30a5c21b" >
			<ee:message />
			<ee:variables >
				<ee:set-variable variableName="numberToColumn" ><![CDATA[%dw 2.0
output application/json
var columnCount= vars.inventoryColumnCount
var nextColumnCount= columnCount + 1
var preColumnCount = columnCount - 1
var letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

fun toExcelColumn(n) =
    if (n <= 0) "" 
    else do {
        var rem = (n - 1) mod 26
        var quotient = floor((n - 1) / 26)
        ---
        toExcelColumn(quotient) ++ letters[(rem) as Number]
    }

---
{ 
  Number: columnCount,
  CurrentColumn: toExcelColumn(columnCount),
  NextColumn: toExcelColumn(nextColumnCount),
  PreviousColumn: toExcelColumn(preColumnCount),
}
]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
	</sub-flow>
