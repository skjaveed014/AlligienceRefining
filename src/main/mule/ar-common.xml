		</http:request>
		<set-variable value="#[payload.formulas]" doc:name="InventorySampleColumnFormulas" doc:id="253a09ff-51ac-4b69-a087-0967b951dfb0" variableName="InventorySampleColumnFormulas" />
		<set-variable value="#[payload.numberFormat]" doc:name="inventorySampleColumnNumberFormat" doc:id="8b87920e-0918-4b51-bd49-86609001996c" variableName="inventorySampleColumnNumberFormat" />
		<ee:transform doc:name="inventoryReplacedFormulas, invSampleColumn" doc:id="59dc8e83-115d-497d-8bf7-36288b6524d4" >
			<ee:message />
			<ee:variables >
				<ee:set-variable variableName="inventoryReplacedFormulas" ><![CDATA[%dw 2.0
output application/json
 
var from1= "B"
var to1= vars.numberToColumn.NextColumn
var from2= "A"
var to2= vars.numberToColumn.CurrentColumn
---

vars."InventorySampleColumnFormulas" map ((row) ->
    row map ((cell) ->
      if (cell is String and sizeOf(cell) > 0 and cell[0] == "=")
        (cell
          replace (("(?:" ++ from1 ++ ")(?=\\d|\\\$)") as Regex) with to1
        )
        replace (("(?:" ++ from2 ++ ")(?=\\d|\\\$)") as Regex) with to2
      else
        cell
    )
  )]]></ee:set-variable>
				<ee:set-variable variableName="invSampleColumn" ><![CDATA[%dw 2.0
output application/json
---
payload.values]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
	</sub-flow>
