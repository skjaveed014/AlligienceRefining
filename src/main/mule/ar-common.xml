	<sub-flow name="ar-common-commo-requester" doc:id="c9b21c87-dd41-469f-becc-b4361e076c61" >
		<until-successful maxRetries="5" doc:name="Until Successful" doc:id="7aa59ec5-c9b1-4cb0-889f-7fef096f0e6d" millisBetweenRetries="5000">
			<try doc:name="Try" doc:id="13bdfd71-df79-4f5b-9e10-faeb27ea7ccc">
			<set-variable value='#[null]' doc:name="Set Variable" doc:id="b31e4c35-fe1f-470d-b088-e46693f3ca29" variableName="httpError" />
				<http:request method="#[vars.vmethod]" doc:name="Request" doc:id="62c8145b-76e3-454d-a90b-c98df1adc1d0" config-ref="HTTP_Graph_API_configuration" path="#[vars.vpath]">
			<http:body><![CDATA[#[vars.vpayload]]]></http:body>
			<http:headers><![CDATA[#[output application/java
---
{
	"Authorization" : "Bearer" ++ vars.token
}]]]></http:headers>
		</http:request>
				<error-handler>
					<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="1a894c06-f0e3-449a-9bdb-0c2698e7e5d1" type="HTTP:CONNECTIVITY, HTTP:TIMEOUT">
						<logger level="INFO" doc:name="Logger" doc:id="b33dbb69-2230-41ec-b9b1-5f0ad84ff22b" message="retrying timeout error"/>
					</on-error-propagate>
					<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="29350122-3058-47ed-a8fd-43c1662b64e1" type="HTTP:BAD_GATEWAY, HTTP:BAD_REQUEST, HTTP:CLIENT_SECURITY, HTTP:FORBIDDEN, HTTP:INTERNAL_SERVER_ERROR, HTTP:METHOD_NOT_ALLOWED, HTTP:NOT_ACCEPTABLE, HTTP:PARSING, HTTP:RETRY_EXHAUSTED, HTTP:SECURITY, HTTP:SERVICE_UNAVAILABLE, HTTP:TIMEOUT, HTTP:TOO_MANY_REQUESTS, HTTP:UNAUTHORIZED, HTTP:UNSUPPORTED_MEDIA_TYPE, EXPRESSION, STREAM_MAXIMUM_SIZE_EXCEEDED" >
						<set-variable doc:name="Set Variable" doc:id="d0e66220-f949-409f-8cf5-92c7787842c7" variableName="httpError" value="#[error.errorType.identifier]"/>
					</on-error-continue>
			</error-handler>
		</try>
		</until-successful>
		<choice doc:name="Choice" doc:id="abc59366-be3b-4653-be88-cab84c334313" >
			<when expression="#[vars.httpError != null]" >
				<raise-error doc:name="Raise error" doc:id="e35762b3-b3c8-461f-b769-56059414e74e" type="APP:HTTP_REQUEST_FAILED" description="#['HTTP error: ' ++ (vars.httpError default 'UNKNOWN')]" />
			</when>
			<otherwise >
				<logger level="INFO" doc:name="Logger" doc:id="46cec7bc-fc3a-4678-aac9-344b37261b93" message="logging" />
			</otherwise>
		</choice>
	</sub-flow>
