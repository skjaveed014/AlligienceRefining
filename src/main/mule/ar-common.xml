			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/csv quoteValues=true

var data = payload

// &#45;&#45;- Flatten all product groups dynamically and merge subtotal & grand total
var allProducts = flatten(
    data.Products pluck ((tanks, productName) ->
        tanks map (t) ->
            t ++
            // Merge product subtotal
            (data.Subtotal[productName&#93; default {}) ++
            // Merge grand total
            (data.GrandTotal default {}) ++
            {
                ProductGroup: productName
            }
    )
)

&#45;&#45;-
allProducts map (item) -> {
    RefineryName: data.RefineryName,
    InventoryDate: data.InventoryDate,
    ReportGeneratedOn: data.ReportGeneratedOn,
    DateAndTime: data.DateAndTime,
    ProductGroup: item.ProductGroup,
    Tank: item.Tank,
    Product: item.Product,
    "Gauge(Date) (Time)": item."Gauge(Date) (Time)",
    "Gauge(Ft In 16)": item."Gauge(Ft In 16)",
    GrossProduct: item.GrossProduct,
    NetProduct: item.NetProduct,
    Temp: item.Temp,
    Density: item.Density,
    TotalWater: item.TotalWater,
    TruckCount: item.TruckCount,
    LastNetProduct: item.LastNetProduct,
    Available: item.Available,
    DeltaNetProduct: item.DeltaNetProduct,
    AvailableCapacity: item.AvailableCapacity,
    TotalCapacity: item.TotalCapacity,

    // &#45;&#45;- Product-level subtotal columns &#45;&#45;-
    Sub_GrossProduct: data.Subtotal[item.ProductGroup&#93;.GrossProduct default "",
    Sub_NetProduct: data.Subtotal[item.ProductGroup&#93;.NetProduct default "",
    Sub_TotalWater: data.Subtotal[item.ProductGroup&#93;.TotalWater default "",
    Sub_LastNetProduct: data.Subtotal[item.ProductGroup&#93;.LastNetProduct default "",
    Sub_Available: data.Subtotal[item.ProductGroup&#93;.Available default "",
    Sub_DeltaNetProduct: data.Subtotal[item.ProductGroup&#93;.DeltaNetProduct default "",
    Sub_AvailableCapacity: data.Subtotal[item.ProductGroup&#93;.AvailableCapacity default "",
    Sub_TotalCapacity: data.Subtotal[item.ProductGroup&#93;.TotalCapacity default "",

    // &#45;&#45;- Grand total columns &#45;&#45;-
    Grand_GrossProductTotal: data.GrandTotal.GrossProductTotal default "",
    Grand_NetProductTotal: data.GrandTotal.NetProductTotal default "",
    Grand_TotalWaterTotal: data.GrandTotal.TotalWaterTotal default "",
    Grand_LastNetProductTotal: data.GrandTotal.LastNetProductTotal default "",
    Grand_AvailableTotal: data.GrandTotal.AvailableTotal default "",
    Grand_DeltaNetProductTotal: data.GrandTotal.DeltaNetProductTotal default "",
    Grand_AvailableCapacityTotal: data.GrandTotal.AvailableCapacityTotal default "",
    Grand_TotalCapacityTotal: data.GrandTotal.TotalCapacityTotal default ""
}
&#93;&#93;></ee:set-payload>
			</ee:message>
		</ee:transform> [STUDIO] -->
