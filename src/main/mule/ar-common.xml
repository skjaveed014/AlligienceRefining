var newFormulaStart= rowNumber + 5

var data = vars."dataWithUnchangedFormulas"

// your new row offset value
var newRowNumber = 20

// function to increment cell references (e.g. D3 → D23)
fun incrementRowNumbers(formula: String, addValue: Number) =
  formula replace /([A-Z&#93;+)(\d+)/ with (
    (m, i) -> 
      m[1&#93; ++ ((m[2&#93; as Number) + addValue) as String
  )

// apply to each formula cell
&#45;&#45;-
data map (row) ->
  row map (cell) ->
    if ((cell default "") startsWith "=")
      incrementRowNumbers(cell, newRowNumber)
    else cell
