		<set-variable value="#[payload.value]" doc:name="Set Variable" doc:id="2055aa99-7375-45c0-8a85-b82d3790db33" variableName="inventoryOrBreakoutColumnCount"/>
		<!-- [STUDIO:"gets inventoryColumnCount"]<http:request method="GET" doc:name="gets inventoryColumnCount" doc:id="73c32de1-f156-4b89-9940-c33a7adc8cb5" config-ref="HTTP_Graph_API_configuration" path="#[&quot;/v1.0/users/&quot; ++ p('graphApi.emailId') ++ &quot;/drive/items/&quot; ++ vars.inventoryAndSalesWorkbookId ++ &quot;/workbook/tables/&quot; ++ vars.invOrBreakoutTableName ++&quot;/columns/count&quot;&#93;" target="inventoryOrBreakoutColumnCount" targetValue="#[payload.value&#93;">
