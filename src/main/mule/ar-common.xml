			<http:request method="GET" doc:name="get template data" doc:id="0cbb39cd-77ff-49f9-8a6c-a9dbe44ccd7b" config-ref="HTTP_Graph_API_configuration" path="#[&quot;/v1.0/users/&quot; ++ p('graphApi.emailId') ++ &quot;/drive/items/&quot; ++ vars.&quot;previousInventoryWorkbookId&quot; ++ &quot;/workbook/worksheets/&quot;++ p('tms6.sheetName')  ++ &quot;/range(address='&quot; ++ vars.&quot;tms6Range&quot;.rangeStart ++&quot;:&quot; ++ vars.&quot;tms6Range&quot;.rangeEnd ++ &quot;')&quot;]">
				<http:headers ><![CDATA[#[output application/json
---
{
	"Authorization" : "Bearer "++ vars."token" as String
}]]]></http:headers>
			</http:request>
			<set-payload value='#[{ &#10;"numberFormat": payload."numberFormat",&#10;"values": payload.formulas &#10;}]' doc:name="templatePayload" doc:id="25904418-b2fa-4512-926d-ac1d53cc0a69" />
			<http:request method="PATCH" doc:name="add template data" doc:id="a161744e-cf7f-4580-9acf-de1e41d9ae5c" config-ref="HTTP_Graph_API_configuration" path="#[&quot;/v1.0/users/&quot; ++ p('graphApi.emailId') ++ &quot;/drive/items/&quot; ++ vars.&quot;inventoryAndSalesWorkbookId&quot; ++ &quot;/workbook/worksheets/&quot;++ p('tms6.sheetName')  ++ &quot;/range(address='&quot; ++ vars.&quot;tms6Range&quot;.rangeStart ++&quot;:&quot; ++ vars.&quot;tms6Range&quot;.rangeEnd ++ &quot;')&quot;]">
				<http:headers ><![CDATA[#[output application/json
---
{
	"Authorization" : "Bearer "++ vars."token" as String
}]]]></http:headers>
			</http:request>
			<http:request method="POST" doc:name="create table" doc:id="e65e0573-899e-43ff-92c8-95afca25b80d" config-ref="HTTP_Graph_API_configuration" path="#[&quot;/v1.0/users/&quot; ++ p('graphApi.emailId') ++ &quot;/drive/items/&quot; ++ vars.inventoryAndSalesWorkbookId ++ &quot;/workbook/tables/add&quot;]" target="autoGeneratedTableName" targetValue="#[payload.name]" >
				<http:body ><![CDATA[#[%dw 2.0
output application/json
---
{
	"address": vars."inventorySheetNames"[4] ++ "!" ++ vars.tms6Range.rangeStart ++ ":" ++ vars.tms6Range.rangeEnd,
	"hasHeaders": true
}]]]></http:body>
				<http:headers ><![CDATA[#[output application/json
---
{
	"Authorization" : "Bearer "++ vars."token" as String
}]]]></http:headers>
			</http:request>
			<set-payload value='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;	"name": vars."exportsReceiptsTableNames"[vars.counter - 1]&#10;}]' doc:name="new table name" doc:id="b8b48ca5-8608-46d9-b8c7-63e90bad988b" />
			<http:request method="PATCH" doc:name="update table name" doc:id="98ce4a35-037a-4a2c-80d7-3407a428e80e" config-ref="HTTP_Graph_API_configuration" path="#[&quot;/v1.0/users/&quot; ++ p('graphApi.emailId') ++ &quot;/drive/items/&quot; ++ vars.inventoryAndSalesWorkbookId ++ &quot;/workbook/worksheets/&quot; ++ vars.&quot;inventorySheetNames&quot;[4]  ++ &quot;/tables/&quot; ++ vars.&quot;autoGeneratedTableName&quot;]" >
				<http:headers ><![CDATA[#[output application/json
---
{
	"Authorization" : "Bearer "++ vars."token" as String
}]]]></http:headers>
			</http:request>
		</foreach>
	</sub-flow>
