var InventoryDate= vars.InventoryDate
var sampleValues = vars."sampleValues"
var dynamicValues= vars."dynamic-values"

fun updateData(data, InventoryDate, dynamicValues) =
    sampleValues map ((row, rowIndex) ->
        if (rowIndex == 0) 
            // Replace first row elements (except the first) with InventoryDate
            [row[0&#93;&#93; ++ (row[1 to -1&#93; map (() -> InventoryDate))
        else
            // Replace any dynamic code in other rows
            row map ((cell) ->
                if (cell as String default "" matches /^(P\d+|Factor-value)$/)
                    dynamicValues[cell&#93; default cell
                else cell
            )
    )


