		<flow-ref doc:name="calling checks-inventory-and-sales-workbook-existense-subflow" doc:id="d4392118-8039-4e20-a1f3-b5a7f7cc4702" name="checks-inventory-and-sales-workbook-existense-subflow" />
		<flow-ref doc:name="calling tis-subflow" doc:id="fd45696b-5b13-4d4a-b644-41cf00fd0385" name="tis-subflow"/>
		<flow-ref doc:name="calling tms6-subflow" doc:id="c10c50e2-379d-4bf2-9867-1adc7dc0723d" name="tms6-subflow"/>
		<flow-ref doc:name="calling get-tis-data-by-inventory-date-subflow" doc:id="97b230b6-0049-45ab-b3e9-ec63e8a1a45b" name="get-tis-data-by-inventory-date-subflow"/>
		<flow-ref doc:name="calling get-tms6-data-by-inventory-date-subflow" doc:id="21471ec3-1137-4273-84d3-53a3f6d33030" name="get-tms6-data-by-inventory-date-subflow" />
		<ee:transform doc:name="inventoryDateInfo" doc:id="a8510a31-cd3c-4afe-aaf0-7b9ca578a4f8">
			<ee:message />
			<ee:variables>
				<ee:set-variable variableName="inventoryDateInfo" ><![CDATA[%dw 2.0
output application/json
 
fun isStartDateOfMonth(date: Date) = date.day == 1
 
fun getPreviousMonthLastDate(date: Date) =
    (date as String {format: "yyyy-MM-01"} as Date) - |P1D|
 
fun getCurrentMonthStartDate(date: Date) =
    date as String {format: "yyyy-MM-01"} as Date
 
fun getDaysInMonth(date: Date) =
    ((date as String {format: "yyyy-MM-01"} as Date) + |P1M| - |P1D|).day
 
var inputDate = vars.inventoryDate
var parsedDate = inputDate as Date {format: "d-MMM-yyyy"}
var previousMonthLastDate = getPreviousMonthLastDate(parsedDate)
var currentMonthStartDate = getCurrentMonthStartDate(parsedDate)
var daysInMonth = getDaysInMonth(parsedDate)
 
---
{
    "originalDate": parsedDate,
    "isStartDateOfMonth": isStartDateOfMonth(parsedDate),
    "daysInMonth": daysInMonth,
    "previousMonthLastDate": previousMonthLastDate as String {format: "d-MMM-yy"},
    "StartDate": currentMonthStartDate as String {format: "d-MMM-yy"},
    "date": parsedDate as String {format: "M/d/yy"},
    "monthYear": parsedDate as String {format: "MMM"},
    "weekday": parsedDate as String {format: "EEEE"}
}]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="calling Inventory-subflow" doc:id="3543b4ff-f691-4e96-8fad-b8b67b8e3857" name="Inventory-subflow" />
	</sub-flow>
	<sub-flow name="inventory-update-subflow" doc:id="46f868b2-fd7f-400f-b985-6e1d102cebca" >
		<set-variable value='#[%dw 2.0&#10;output application/json&#10;var date= attributes.queryParams.inventoryDate as Date {format: "d-MMM-yyyy"}&#10;---&#10;date]' doc:name="inventoryDate" doc:id="efff9cc6-7742-442a-9d9f-07d0cd31ccfd" variableName="inventoryDate"/>
		<set-variable value='#[%dw 2.0&#10;output application/json&#10;var date=vars.inventoryDate as Date {format: "d-MMM-yyyy"}&#10;---&#10;"Inventory_&amp;_Sales_" ++ date.year]' doc:name="workbookName" doc:id="766ac28a-8354-40d2-b524-47d72815c425" variableName="workbookName"/>
		<flow-ref doc:name="calling get-token-subflow" doc:id="4e818d4d-5280-4901-8a59-1e1013efbf23" name="get-token-subflow" />
		<set-variable value="01NVG26FRCBRAVHMCZWRDIOHKMIGJ4FZPV" doc:name="previousInventoryWorkbookId" doc:id="be38a217-5633-4255-abd2-fc08be4956df" variableName="previousInventoryWorkbookId"/>
		<http:request method="GET" doc:name="get Existing Inventory&amp;Sales workbookId" doc:id="b668ac1b-76f8-4006-b7a8-c631b2ed9cfe" config-ref="HTTP_Graph_API_configuration" path="#[&quot;/v1.0/users/&quot; ++ p('graphApi.emailId') ++ &quot;/drive/root:/&quot; ++ p('inventory_&amp;_sales.foldername') ++&quot;/&quot; ++ vars.&quot;workbookName&quot; ++ &quot;.xlsx&quot;]" target="inventoryAndSalesWorkbookId" targetValue="#[payload.id]">
			<http:headers><![CDATA[#[output application/json
---
{
	"Authorization" : "Bearer "++ vars."token" as String
}]]]></http:headers>
		</http:request>
		<flow-ref doc:name="calling get-tis-data-by-inventory-date-subflow" doc:id="be26b5cf-2c1f-4af5-806a-ac067977255e" name="get-tis-data-by-inventory-date-subflow" />
		<flow-ref doc:name="calling get-tms6-data-by-inventory-date-subflow" doc:id="b9b5c4cf-d040-4a92-a058-60d574717c86" name="get-tms6-data-by-inventory-date-subflow" />
		<flow-ref doc:name="calling Inventory-subflow" doc:id="68a624ce-c8b5-4a6e-a2ed-7853d4c47cd1" name="Inventory-subflow" />
