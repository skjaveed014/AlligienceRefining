output application/json
var formulas = vars."inventoryReplacedFormulas"
var data = vars.assemblyProductsData
&#45;&#45;-
formulas map (row) ->
  row map (cell) ->
    if (cell startsWith "=") cell
    else if (cell == "Date") 
        (data.Date as Date { format: "d-MMM-yyyy" }) as String { format: "dd-MMM-yyyy" }
    else if (cell == "weekday") 
        data.weekday
    else if (data[cell&#93;? != null) 
        data[cell&#93;
    else 
        cell
