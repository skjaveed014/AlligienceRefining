<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<flow name="months-sheet-creationFlow" doc:id="7b547da3-f522-4912-b370-4e0119df5bcd" >
		<http:listener doc:name="Listener" doc:id="c28ba7d2-1ece-4f0b-892e-896209036acf" config-ref="HTTP_Listener_config" path="/frpsheet"/>
		<ee:transform doc:name="setting time" doc:id="a965e755-2c8e-417b-9ab3-023b93a34401" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="time" ><![CDATA[%dw 2.0
output application/json
var d = payload //date will come here
---
{
 "my":(d as Date {format: "d-MMM-yyyy"}) as String {format: "MMM-yyyy"},
 "month":(d as Date {format: "d-MMM-yyyy"}) as String {format: "MMM"},
 "year":(d as Date {format: "d-MMM-yyyy"}) as String {format: "yyyy"},
}]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<http:request method="POST" doc:name="token generation" doc:id="a7d794fe-30e7-493f-900c-d8629fed2914" url="https://login.microsoftonline.com/82bd2b79-844a-4f08-bd21-0949a05fcedb/oauth2/v2.0/token" target="token" targetValue="#[payload.access_token]">
			<http:body ><![CDATA[#[%dw 2.0
output application/x-www-form-urlencoded
---
{
	"client_id":"37f36d2d-0a89-483f-aef6-cf7610581a74",
	"client_secret":"Yoz8Q~qYZ7o.2c2zur3EWhLTu.aSWjHZSlsNxa6-",
	"scope":"https://graph.microsoft.com/.default",
	"grant_type":"client_credentials"
}]]]></http:body>
		</http:request>
		<http:request method="GET" doc:name="get list of years" doc:id="c8f31829-7318-43c7-8dd7-94f64079f7d8" url="https://graph.microsoft.com/v1.0/users/jshaik@mdwhub.com/drive/root:/AR/Freepoint_Workbooks:/children?$select=name" target="yearArray" targetValue="#[payload.value.name]">
			<http:headers ><![CDATA[#[output application/java
---
{
	"Authorization" : "Bearer" ++ vars.token
}]]]></http:headers>
		</http:request>
		<ee:transform doc:name="Transform Message" doc:id="aca0cf3f-e564-45a6-b22e-9e32aeb26235" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="checkYear" ><![CDATA[%dw 2.0
output application/json
var arr = vars.yearArray
---
arr contains  vars.time.year
]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<choice doc:name="Choice" doc:id="78138d39-a7b2-4d38-a9dd-00041e70b456" >
			<when expression="#[vars.checkYear == true]">
				<http:request method="GET" doc:name="get list of months in an year folder" doc:id="200439bf-d431-4328-9f45-fc422c06d65d" url='#["https://graph.microsoft.com/v1.0/users/jshaik@mdwhub.com/drive/root:/AR/Freepoint_Workbooks/"++ vars.time.year ++":/children?\$select=name"]' target="monthsArray" targetValue="#[payload.value.name]">
					<http:headers ><![CDATA[#[output application/java
---
{
	"Authorization" : "Bearer" ++ vars.token
}]]]></http:headers>
				</http:request>
				<ee:transform doc:name="Transform Message" doc:id="9398ca37-0b5b-46e9-8e64-d78087b9708b">
					<ee:message />
					<ee:variables>
						<ee:set-variable variableName="checkMonth"><![CDATA[%dw 2.0
output application/json
var arr = vars.monthsArray
---
arr contains ("Freepoint_Worksheet_" ++ (vars.time.my replace "-" with "_") ++ ".xlsx")
]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
				<flow-ref doc:name="Flow Reference" doc:id="cdf8a146-f402-46d0-86b8-98266487789e" name="month-checking-sub-flow"/>
			</when>
			<otherwise >
				<http:request method="POST" doc:name="year folder creation" doc:id="f9cd157a-b37f-4267-93fc-3c11151c940c" url="https://graph.microsoft.com/v1.0/users/jshaik@mdwhub.com/drive/root:/AR/Freepoint_Workbooks:/children">
					<http:body ><![CDATA[#[{
  "name": vars.time.year,
  "folder": {},
  "@microsoft.graph.conflictBehavior": "rename"
}]]]></http:body>
					<http:headers ><![CDATA[#[output application/java
---
{
	"Authorization" : "Bearer" ++ vars.token
}]]]></http:headers>
				</http:request>
				<ee:transform doc:name="Transform Message" doc:id="4c98943b-d996-4395-a03a-38945758f0e6">
					<ee:message>
					</ee:message>
					<ee:variables>
						<ee:set-variable variableName="checkMonth"><![CDATA[%dw 2.0
output application/json
var arr = vars.monthsArray
---
arr contains ("Freepoint_Worksheet_" ++ (vars.time.my replace "-" with "_") ++ ".xlsx")
]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
				<flow-ref doc:name="Flow Reference" doc:id="595e9f7a-92e1-4178-8709-a02e8e315c44" name="month-checking-sub-flow"/>
			</otherwise>
		</choice>
	</flow>
	<sub-flow name="month-checking-sub-flow" doc:id="fff26a40-432e-4c17-9a15-06194ce54ee1" >
		<choice doc:name="Choice" doc:id="19b76124-2fc6-4744-b971-980e853cf56c">
					<when expression="#[vars.checkMonth==true]">
				<ee:transform doc:name="Transform Message" doc:id="b341b7f3-af79-49f2-b396-475f62c79132" >
					<ee:message />
					<ee:variables >
						<ee:set-variable variableName="folderName" ><![CDATA[vars.time.year]]></ee:set-variable>
						<ee:set-variable variableName="workBookName" ><![CDATA["Freepoint_Worksheet_" ++ (vars.time.my replace "-" with "_") ++ ".xlsx"]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
				<http:request method="GET" doc:name="getting existing month sheet item id" doc:id="fb11d9f2-6f1c-470a-9da1-9f73534771fb" url='#["https://graph.microsoft.com/v1.0/users/jshaik@mdwhub.com/drive/root:/AR/Freepoint_Workbooks/" ++ vars.folderName ++ "/" ++ vars.workBookName]' target="itemId" targetValue="#[payload.id]">
					<http:headers ><![CDATA[#[output application/java
---
{
	"Authorization" : "Bearer" ++ vars.token
}]]]></http:headers>
				</http:request>
					</when>
			<otherwise >
				<http:request method="PUT" doc:name="workbook creation" doc:id="b348858d-f5f2-49a4-8171-db2594512792" url='#["https://graph.microsoft.com/v1.0/users/jshaik@mdwhub.com/drive/root:/AR/Freepoint_Workbooks/" ++ vars.time.year ++ "/" ++ "Freepoint_Worksheet_" ++ (vars.time.my replace "-" with "_") ++ ".xlsx:/content"]' target="itemId" targetValue="#[payload.id]">
					<http:body ><![CDATA[#[""]]]></http:body>
					<http:headers ><![CDATA[#[output application/java
---
{
	"Authorization" : "Bearer" ++ vars.token
}]]]></http:headers>
				</http:request>
				<http:request method="PATCH" doc:name="renaming sheet1 name to daily" doc:id="eb8a435c-d770-4d60-a934-245b92e70e2e" url='#["https://graph.microsoft.com/v1.0/users/jshaik@mdwhub.com/drive/items/" ++ vars.itemId ++ "/workbook/worksheets/Sheet1"]'>
					<http:body ><![CDATA[#[%dw 2.0
output application/json
---
{
  "name": "Daily"
}]]]></http:body>
					<http:headers ><![CDATA[#[output application/java
---
{
	"Authorization" : "Bearer" ++ vars.token
}]]]></http:headers>
				</http:request>
				<ee:transform doc:name="Transform Message" doc:id="3cea0592-932a-4a99-acdf-6167f8ed4515">
							<ee:message>
							</ee:message>
							<ee:variables>
								<ee:set-variable variableName="folderName"><![CDATA[vars.time.year]]></ee:set-variable>
								<ee:set-variable variableName="workBookName"><![CDATA["Freepoint_Worksheet_" ++ (vars.time.my replace "-" with "_") ++ ".xlsx"]]></ee:set-variable>
							</ee:variables>
						</ee:transform>
				<foreach doc:name="For Each" doc:id="5980da84-1fa1-42a5-ac53-f3aa58fd20e7" collection='["3days","trueup"]'>
					<http:request method="POST" doc:name="adding sheets to new workbook" doc:id="fde38e64-d760-45a2-8f9f-2c643e12619e" url='#["https://graph.microsoft.com/v1.0/users/jshaik@mdwhub.com/drive/items/" ++ vars.itemId ++ "/workbook/worksheets/add"]'>
					<http:body><![CDATA[#[%dw 2.0
output application/json
---
{
  "name": payload
}]]]></http:body>
					<http:headers><![CDATA[#[output application/java
---
{
	"Authorization" : "Bearer" ++ vars.token
}]]]></http:headers>
				</http:request>
				</foreach>
				<!-- [STUDIO:"setting trueup sheet headers"]<http:request method="PATCH" doc:name="setting trueup sheet headers" doc:id="4ec12dba-88ab-4f31-b451-d2a560f7c0bc" url="#[&quot;https://graph.microsoft.com/v1.0/users/jshaik@mdwhub.com/drive/items/&quot; ++ vars.itemId ++ &quot;/workbook/worksheets/trueup/range(address='A1:E1')&quot;&#93;">
					<http:body ><![CDATA[#[%dw 2.0
output application/json
&#45;&#45;-
{
    "values":[
        ["Inventory Date","Products","T-SAR Inventory","Freepoint Purchased","Difference"&#93;
    &#93;
}&#93;&#93;&#93;></http:body>
					<http:headers ><![CDATA[#[output application/java
&#45;&#45;-
{
	"Authorization" : "Bearer" ++ vars.token
}&#93;&#93;&#93;></http:headers>
				</http:request> [STUDIO] -->
				<!-- [STUDIO:"create table in trueup"]<http:request method="POST" doc:name="create table in trueup" doc:id="eebcde39-c7e7-4b7d-a9ab-4298450a82bf" url='#["https://graph.microsoft.com/v1.0/users/jshaik@mdwhub.com/drive/items/" ++ vars.itemId ++ "/workbook/worksheets/trueup/tables/add"&#93;'>
					<http:body ><![CDATA[{
  "address": "A1:E1",
  "hasHeaders": true
}&#93;&#93;></http:body>
					<http:headers ><![CDATA[#[output application/java
&#45;&#45;-
{
	"Authorization" : "Bearer" ++ vars.token
}&#93;&#93;&#93;></http:headers>
				</http:request> [STUDIO] -->
				<!-- [STUDIO:"renaming table in trueup"]<http:request method="PATCH" doc:name="renaming table in trueup" doc:id="7efb4476-2088-47d4-bed2-2e4263c639c9" url='#["https://graph.microsoft.com/v1.0/users/jshaik@mdwhub.com/drive/items/" ++ vars.itemId ++ "/workbook/worksheets/trueup/tables/" ++ payload.name&#93;'>
					<http:body ><![CDATA[#[%dw 2.0
output application/json
&#45;&#45;-
{
    "name":"trueupTable"
}&#93;&#93;&#93;></http:body>
					<http:headers ><![CDATA[#[output application/java
&#45;&#45;-
{
	"Authorization" : "Bearer" ++ vars.token
}&#93;&#93;&#93;></http:headers>
				</http:request> [STUDIO] -->
			</otherwise>
				</choice>
	</sub-flow>
</mule>
