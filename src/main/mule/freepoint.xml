			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="incrFormulae" ><![CDATA[%dw 2.0
output application/json
---
vars.incrFormulae map (row) -> 
  row map (cell) -> 
    if (cell == "x") vars.crudeSlateBarl.Crude[0]
    else if (cell == "y") vars.diffValueSet.Crude
    else cell]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<ee:transform doc:name="setting column formulas" doc:id="6c47bec2-8626-497d-8bc8-c50cc525ed5a">
			<ee:message>
			</ee:message>
			<ee:variables>
				<ee:set-variable variableName="formulas"><![CDATA[%dw 2.0
output application/json

var data = vars.incrFormulae
---
(data[0] map ((header, index) ->
    (
        // Create an array of arrays:
        ([header] ++ (data[1 to -1] map (row) -> row[index]))
            // Wrap each value in its own array
            map (item) -> [item]
    )
))
]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<ee:transform doc:name="first 3 columns set" doc:id="8452a966-1db8-4619-a4c8-a5225213126a">
			<ee:message>
			</ee:message>
			<ee:variables>
				<ee:set-variable variableName="numFormatSet"><![CDATA[%dw 2.0
output application/json

var formats = vars.sampleFormat

// ✅ Transpose — group all 1st, 2nd, 3rd … values across sets
---
(0 to (sizeOf(formats[0]) - 1)) map (i) ->
    formats map (row) -> [ row[i] ]
]]></ee:set-variable>
				<ee:set-variable variableName="columns5Payload"><![CDATA[%dw 2.0
output application/json

var freepointData = {
    "Products": vars.freepointData.Products
}

var sampleColumn = vars.sampleProducts

// ✅ Fixed normalize function
fun normalize(v) =
    if (v contains "(")
 ((v replace "(" with "-") replace ")" with "")
else v

---
{
  "Date": [["Inventory Date"]] ++ ((2 to (sizeOf(vars.sampleProducts) - 3)) map (() -> [vars.date])) ++ [[""], [""]] ++ [[vars.date]],

  
  "Products":vars.sampleProducts,
  
    Quantity: 
        [["Quantity(bbls)"]] ++
        (sampleColumn[1 to (sizeOf(sampleColumn) - 1)] map (p) ->
            [normalize((freepointData.Products[p[0]] default {})["Quantity (bbls)"] default "")]
        ),

    "Unit Price per Gal": vars.unitPriceColumn,

    "Differential per Gal": vars.diffValueColPayload
}
]]></ee:set-variable>
