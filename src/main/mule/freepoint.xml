		<ee:transform doc:name="merging prods and diff values and subtract less rvo" doc:id="6105037b-dfbf-4a28-bb20-f69b75ae4337" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="diffValueSet" ><![CDATA[%dw 2.0
output application/json


var keys = vars.input1[1 to -1] map $[0]
var values = vars.input2[1 to -1] map $[0]

var data=(keys zip values) reduce ((item, acc = {}) -> acc ++ { (item[0]): item[1] })

var lessRVO = vars.unitPrices."Less RVO"[0]

---
data mapObject ((value, key) ->
    if (key contains "Export")
        { (key): value - (lessRVO) }
    else
        { (key): value }
)
]]></ee:set-variable>
			</ee:variables>
