		<ee:transform doc:name="dates" doc:id="feffa624-080b-4663-a602-25761f70e63c">
			<ee:message>
			</ee:message>
			<ee:variables>
				<ee:set-variable variableName="dates" ><![CDATA[%dw 2.0
output application/json

var input1 = vars."freepoint-idp-response"


// Function to parse string like "26-Aug-2025" into a date
fun toDate(str) = (str as Date { format: "d-MMM-yyyy" })

var startDate = toDate(input1.PriorInventoryDate) + |P1D|   //  prior inventory date + 1 day
var endDate = toDate(input1."Inventory Date")

// Generate all dates between startDate and endDate (inclusive)
fun dateRange(from, to) =
    if (from > to) [] 
    else [from as String {format: "d-MMM-yyyy"}] ++ dateRange(from + |P1D|, to)

var datesList = dateRange(startDate, endDate)

// Extract day parts and month-year for tableDate
var dayParts = datesList map ((it) -> (it splitBy "-")[0])
var monthYear = (datesList[-1] splitBy "-")[1 to 2] joinBy "-"

var tableDate = (dayParts joinBy "-") ++ "-" ++ monthYear

---
{
    dates: datesList,
    threeDatesTableName: tableDate
}
]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
