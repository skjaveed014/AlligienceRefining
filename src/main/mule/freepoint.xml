		<ee:transform doc:name="RequestData" doc:id="ed1eb8bb-e57c-4a80-bd21-9f63d7398014">
			<ee:message />
			<ee:variables>
				<ee:set-variable variableName="tableRange"><![CDATA[%dw 2.0
output application/json
var rowNumber= vars.rowNumber // used row number in sheet
var productCount = vars.freepointSampleTableRowsCount - 1// sample table size vertically
---
{
    range: 
            "A" ++ (rowNumber + 3) ++ ":" ++ "L" ++ ((rowNumber + 2) + productCount)
}]]></ee:set-variable>
				<ee:set-variable variableName="requestData" ><![CDATA[%dw 2.0
output application/json

// changing formulas


var usedRange = vars.rowNumber
var gap = 2
var shift = usedRange + gap     // new-table start
var start = shift         // first row
var end   = shift + (vars.freepointSampleTableRowsCount - 1)  
var data = vars.dataWithUnchangedFormulas       // (sample products size -1)

// increment ranges like A2:A14
fun incRanges(f, s) =
  f replace /([A-Z]+)(\d+):([A-Z]+)(\d+)/ with ((m) ->
    m[1] ++ ((m[2] as Number) + s) ++ ":" ++ m[3] ++ ((m[4] as Number) + s)
  )

// increment single refs but avoid refs that are part of ranges
fun incSingles(f, s) =
  f replace /(?<!:)([A-Z]+)(\d+)(?!:)/ with ((m) ->
    m[1] ++ ((m[2] as Number) + s)
  )

// NEW → Replace START/END with actual numbers for SUM formulas
fun replaceStartEnd(str, start, end) =
  str
    replace /'START'/ with (start as String)
    replace /'END'/ with (end as String)

// FULL formula updater
fun incrementFormula(formula, s) =
  replaceStartEnd(
    incSingles(incRanges(formula, s), s),
    start,
    end
  )

---
data map (column, colIndex) ->
  column map (row, rowIndex) ->
    do {
      var cell = row
      ---
      if ((cell is String) and (cell startsWith "="))
        [ incrementFormula(cell, shift) ]
      else
        [ cell ]
    }

]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
