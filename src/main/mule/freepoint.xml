		<ee:transform doc:name="trueUpRequestData  4 columns" doc:id="9e9c24ec-5512-4e5a-9857-cdc555ab119a" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="trueUpRequestData" ><![CDATA[%dw 2.0
output application/json
var inventoryDate= vars.InventoryValues.InventoryDate
var freepointProducts = vars.freepointProducts
var freepointQuantities= vars.freepointQuantities
var t_sarInventory= vars.InventoryValues.Values

// removes null or empty products
var freepointProductsFiltered =
    (freepointProducts map ($[0] default "")) filter ($ != "")

var freepointQuantitiesFiltered =
    (freepointQuantities map ($[0] default "")) filter ($ != "")

var tsarValues =
    (freepointProductsFiltered) map ((p) -> (t_sarInventory[p] default ""))

var result = [
    // Inventory Date row
    ["Inventory Date"] ++ ((freepointProductsFiltered) map (() -> inventoryDate)),

    // Products row
    ["Products"] ++ freepointProductsFiltered,

    // T-SAR Inventory row
    ["T-SAR Inventory"] ++ tsarValues,

    // Freepoint Purchased row
    ["Freepoint Purchased"] ++ freepointQuantitiesFiltered
]

// into array of arrays
var data = result  map ((col) -> col map ((row) -> [row]))
---
data map ((row) -> row filter ((item, index) -> index != 1))]]></ee:set-variable>
