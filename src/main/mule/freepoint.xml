		<ee:transform doc:name="incremented formulas" doc:id="245e32a0-167b-4235-9635-c684d8352cb4">
			<ee:message>
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="incrFormulae" ><![CDATA[%dw 2.0
output application/json
 
var rowCount = vars.rowCount  // number of already existing rows
var totalRows = sizeOf(vars.sampleProducts) - 1 // number of new formula sets to generate or new table size .here subtracting -1 is for not to consider the last total row coz they have seperate formulae coz it needs to add all the above rows right?
 
// only the formula rows, no blanks or SUM
var baseFormulas = payload.formulas

// Function to replace only cell references (letter followed by number that's preceded by = or operator)
fun incrementRowInFormula(formula: String, newRow: Number) = 
  formula replace /([\=\+\*\-\/\(])([A-Z]+)(\d+)/ with ((matchArray, index) ->
    matchArray[1] ++ matchArray[2] ++ (newRow as String)
  )
 
---

if(rowCount == 1) payload.formulas // if there is no table in data sheet then formulas need not to increment, it can simply add into data sheet from sample sheet
else
(
  (1 to totalRows) map (x) ->
    baseFormulas[x - 1] default [] map (f) ->
      incrementRowInFormula(f, rowCount + 1 + x)
) ++  [ ["", "", "", "", "=SUM(J" ++ (rowCount+3)++":J" ++ (rowCount +1 + totalRows) ++ ")"]
]
]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<ee:transform doc:name="setting column formulas" doc:id="6c47bec2-8626-497d-8bc8-c50cc525ed5a" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="formulas" ><![CDATA[%dw 2.0
output application/json

var data = vars.incrFormulae
---
(data[0] map ((header, index) ->
    (
        // Create an array of arrays:
        ([header] ++ (data[1 to -1] map (row) -> row[index]))
            // Wrap each value in its own array
            map (item) -> [item]
    )
))
]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
