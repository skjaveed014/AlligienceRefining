		<ee:transform doc:name="incremented formulas" doc:id="245e32a0-167b-4235-9635-c684d8352cb4">
			<ee:message>
			</ee:message>
			<ee:variables>
				<ee:set-variable variableName="incrFormulae"><![CDATA[%dw 2.0
output application/json

var rowCount = vars.rowCount
var totalRows = sizeOf(vars.sampleProducts) - 1

var baseFormulas: Array<Array<String | Number>> =payload.formulas
// Function to replace ALL cell references using scan and reduce
fun incrementAllCellRefs(formula: String, offset: Number): String = do {
  var matches = formula scan /([A-Z]+)(\d+)/
  ---
  if (isEmpty(matches)) formula
  else matches reduce ((match, acc = formula) -> 
    acc replace (match[0]) with (match[1] ++ ((match[2] as Number) + offset) as String)
  )
}

var offset = rowCount + 1 // Calculate offset based on existing rows

---
if(rowCount == 1) baseFormulas
else
  baseFormulas map (row, rowIndex) ->
    if (rowIndex == 0) row  // Keep header row unchanged
    else row map (cell) ->
      cell match {
        case s is String -> if (s startsWith "=") incrementAllCellRefs(s, offset) else s
        else -> cell
      }]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
