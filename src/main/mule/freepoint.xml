		<flow-ref doc:name="calling get-sample-freepoint-table-Sub_Flow" doc:id="ecc24746-dc6b-41f9-8464-de04a3176f23" name="get-sample-freepoint-table-Sub_Flow"/>
		<ee:transform doc:name="dataWithUnchangedFormulas" doc:id="7bc59776-87c3-415d-890d-a7ae1795c20a">
			<ee:message />
			<ee:variables>
				<ee:set-variable variableName="dataWithUnchangedFormulas"><![CDATA[%dw 2.0
output application/json
var InventoryDate= vars.InventoryDate
var sampleValues = vars."sampleData"
var dynamicValues= vars."dynamicValues"
var quantites= vars."freepoint-idp-response".Products mapObject ((value, key, index) -> (key): value."Quantity (bbls)" )
var unitPrices = vars."PriceForFundingData"
var differentialValues = vars."differentialValuesByLookupWithLessRVO"

fun updateData(data) =
    data map ((row, rowIndex) ->
        row map ((cell, colIndex) ->

            // STEP 1 → Replace dynamic reference values
            if ((cell default "") is String and (cell matches /^(P\d+|Crude UnitPrice per barrel|Crude Diff per barrel)$/))
                dynamicValues[cell] default cell
                
            // STEP 2 → Fill quantity row
            else if (rowIndex == 2 and colIndex > 0)
                quantites[data[1][colIndex]] default cell

            // STEP 3 → Fill unit prices row
            else if (rowIndex == 3 and colIndex > 0)
                unitPrices[data[1][colIndex]] default cell

            // STEP 4 → Fill differential row (NO LOOKUP)
            else if (rowIndex == 4 and colIndex > 0)
                differentialValues[data[1][colIndex]] default cell
			 // STEP 5 → Replace inventory date
            else 
				(cell as String) replace "02-Aug-2025" with InventoryDate
        )
    )

---
updateData(sampleValues)]]></ee:set-variable>
			</ee:variables>
