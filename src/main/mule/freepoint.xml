		<ee:transform doc:name="setting products and their unit prices parallelly" doc:id="7b2ebc41-5f22-4e9d-9904-ecb8734bb3cc" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="unitPrices" ><![CDATA[%dw 2.0
output application/json

var input1 = vars.pricesSheetProds //products names from prices sheet
var input2 = vars.priceSheetUnitPrices //unit prices of the next date of today from unit prices sheet
---
(input1 zip input2)
    map ((item, index) ->
        if ((item[0][0] indexOf "Crude") != -1 or (item[0][0] indexOf "ATB") != -1)
            {(item[0][0]): round(((item[1][0]) / 42 * 10000)) / 10000}
        else
            {(item[0][0]): item[1][0]}
    )
]]></ee:set-variable>
			</ee:variables>
