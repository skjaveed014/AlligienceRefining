	<sub-flow name="qb-invoiceSub_Flow" doc:id="0723cabb-7632-4a3e-9991-8e6234e4d5f1" >
		<http:request method="GET" doc:name="get purchase amount from frp tables" doc:id="68f57ccf-6e2c-48d3-9296-a219c8189cf0" url='#["https://graph.microsoft.com/v1.0/users/jshaik@mdwhub.com/drive/items/" ++ vars.itemId ++ "/workbook/worksheets/Sheet1/tables/freepoint_" ++ (vars.date replace "-" with "_") ++ "/columns/Purchase"]' targetValue="#[payload.values]" target="amountValues">
			<http:headers ><![CDATA[#[output application/java
---
{
	"Authorization" : "Bearer" ++ vars.token
}]]]></http:headers>
		</http:request>
		<http:request method="GET" doc:name="get items from qb" doc:id="e6df1e2d-bc14-43ea-9ef4-7931b293309a" config-ref="HTTP_Request_configuration22" path="/v3/company/9341454875771769/query?query=select * from Item&amp;minorversion=75" >
			<http:headers ><![CDATA[#[output application/java
---
{
	"Accept" : "application/json"
}]]]></http:headers>
		</http:request>
		<ee:transform doc:name="setting item ids" doc:id="55e4589b-3533-46f4-83cf-b8023f43ebd8" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="itemIds" ><![CDATA[%dw 2.0
output application/json
---
payload.QueryResponse.Item 
    reduce ((item, acc = {}) -> 
        acc ++ { (item.Name): item.Id }
    )]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<ee:transform doc:name="Transform Message" doc:id="12015c2d-7ba1-4b89-94cc-5b0257e41cc6" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="qty-amount-qb-set" ><![CDATA[%dw 2.0
output application/json

var products = vars.columns5Payload.Products[1 to -4]     
var quantities = vars.columns5Payload.Quantity[1 to -4]

var qbMap = {
    "Crude":"Crude - Freepoint",
    "Gasoline - Domestic":"CBOB - Domestic",
    "Gasoline - Export":"CBOB - Exports",
    "ULSD - Domestic":"ULSD",
    "ULSHO - Export":"ULSHO",
    "ATB":"ATB",
    "JPTS (includes sales to TSAR)":"JPTS",
    "DHT Feed":"DHT Feed",
    "Naphtha":"Naphtha",
    "Isomerate":"Isomerate",
    "Reformate":"Reformate"
}
 var itemId=vars.itemIds

var values= vars.amountValues
---
(products) map ((p, i) ->
    {
        product: (qbMap[p[0]] default p[0]),
        quantity: if (quantities[i][0] == "" or quantities[i][0] == null)
            0
        else
            (quantities[i][0] replace "," with "") as Number,
        itemId: itemId[(qbMap[p[0]] default p[0])] default null,
        amount : values[i+1][0]
    }
)]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<ee:transform doc:name="Transform Message" doc:id="f56ebaeb-d75f-40e5-a178-403733d04848" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="qbPayload" ><![CDATA[%dw 2.0
output application/json

var items = vars."qty-amount-qb-set"  // your qty amount qb set input array

---
{
    Line: items map (item) -> {
        Amount: item.amount,
        DetailType: "SalesItemLineDetail",
        SalesItemLineDetail: {
            ItemRef: {
                value: item.itemId,
                name: item.product
            },
            Qty: item.quantity,
            TaxCodeRef: {
                value: "NON"
            }
        }
    },

    // keep your customer same
    CustomerRef: {
        value: "59"
    }
}
]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<http:request method="POST" doc:name="invoice generation" doc:id="2161bcd4-b0b8-45ff-9282-afd7bf89ad6b" config-ref="HTTP_Request_configuration22" path="/v3/company/9341454875771769/invoice?minorversion=75" >
			<http:body ><![CDATA[#[vars.qbPayload]]]></http:body>
			<http:headers ><![CDATA[#[output application/java
---
{
	"" : ""
}]]]></http:headers>
		</http:request>
	</sub-flow>
