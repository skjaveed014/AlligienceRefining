			<ee:variables >
				<ee:set-variable variableName="PriceForFundingData" ><![CDATA[%dw 2.0
output application/json
var products= vars."priceForFunding-products"
var values= vars."priceForFunding-values"
var data=flatten(
    products map (p, index) ->
        (p[0] splitBy ",") map (item) ->
            {
                product: trim(item),
                value: values[index][0]
            }
) filter ((item, index) -> item.product !="")

var dataWithOutChange=(data map (item) ->
    {
        (item.product): item.value
    }
) reduce ($$++$)
var dataWithOutATB= dataWithOutChange - "ATB"
---
dataWithOutATB ++ { ATB: (dataWithOutChange.ATB / 42) as String {format: "#.####"} }]]></ee:set-variable>
