		<ee:transform doc:name="setting products and their unit prices parallelly" doc:id="8c33397f-a799-423e-88c2-e009207b68f3" >
			<ee:message />
			<ee:variables >
				<ee:set-variable variableName="unitPrices" ><![CDATA[%dw 2.0
output application/json

var input1 = vars.pricesSheetProds //products names from prices sheet
var input2 = vars.priceSheetUnitPrices //unit prices of the next date of today from unit prices sheet
---
(input1 zip input2)
    map ((item, index) ->
    	if((item[0][0] indexOf "Crude") != -1)
    	    {(item[0][0]): ""}
        else if ((item[0][0] indexOf "ATB") != -1)
            {(item[0][0]): round(((item[1][0]) / 42 * 10000)) / 10000}
        else
            {(item[0][0]): item[1][0]}
    )
]]></ee:set-variable>
				<ee:set-variable variableName="crudeSlateBarl" ><![CDATA[%dw 2.0
output application/json

var input1 = vars.pricesSheetProds //products names from prices sheet
var input2 = vars.priceSheetUnitPrices //unit prices of the next date of today from unit prices sheet
---
(input1 zip input2)
    map ((item, index) ->
    	if((item[0][0] indexOf "Crude") != -1)
    	    {(item[0][0]): item[1][0]}
        else
            null
    )]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<ee:transform doc:name="Transform Message" doc:id="f9d6c201-b9ac-4064-9cad-a7c6ab12ee16" >
			<ee:message />
			<ee:variables >
				<ee:set-variable variableName="unitPriceColumn" ><![CDATA[%dw 2.0
output application/json

var input1 = vars.sampleProducts[1 to -4]
var input2 = vars.unitPrices

// Merge all input2 objects into one map for lookup
var lookup = input2 reduce ((acc, item) -> acc ++ item)

---
[["unit price per gal"]] ++ (input1 map (item) -> do {
    var key = trim(item[0] as String)
    ---
    [lookup[key] default 0]
}) ++ [[""],[""],[""]]

]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
	</sub-flow>
