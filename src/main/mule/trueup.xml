		</http:request>
				<http:request method="PATCH" doc:name="renaming table" doc:id="ebb1e69d-3207-42b3-89cd-aeee04df1583" path='#["/v1.0/users/jshaik@mdwhub.com/drive/items/" ++ vars.itemId ++ "/workbook/worksheets/" ++ vars.sheetName ++ "/tables/" ++ payload.name]' config-ref="HTTP_Graph_API_configuration">
			<http:body><![CDATA[#[%dw 2.0
output application/json
---
{
    "name":vars.tableName
