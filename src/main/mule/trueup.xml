			<http:headers><![CDATA[#[output application/java
---
{
	"Authorization" : "Bearer" ++ vars.token
}]]]></http:headers>
		</http:request>
			</when>
			<otherwise >
				<ee:transform doc:name="Transform Message" doc:id="273d96f7-55b6-41be-ba45-0c25722ea67c" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json

var rows = vars.trueUpRowsPayload.values
var header = rows[0]
var data = rows[1 to -1]

---
{
  values: header map ((h, idx) ->
