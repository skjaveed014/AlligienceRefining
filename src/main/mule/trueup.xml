}]]]></http:headers>
		</http:request>
		<ee:transform doc:name="Transform Message" doc:id="920d4d66-2901-42ba-bc3b-22e0a33f61c1" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="frpPurchasedSet" ><![CDATA[%dw 2.0
output application/json

var keys = vars.prods[1 to -1] map $[0]
var values = vars.quantity[1 to -1] map $[0]

---
(keys zip values) reduce ((item, acc = {}) -> acc ++ { (item[0]): item[1] })
]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<http:request method="GET" doc:name="get trueup rowcount" doc:id="293b9890-f8ba-4654-a1ff-c915bdaa84b4" url='#["https://graph.microsoft.com/v1.0/drives/2094b369-dbb6-4fd0-afd9-3e78830f8e98/items/" ++ vars.itemId ++ "/workbook/worksheets/trueup/usedRange(valuesOnly=true)/rowCount"]' target="rows" targetValue="#[payload.value]">
			<http:headers ><![CDATA[#[output application/java
---
{
	"Authorization" : "Bearer" ++ vars.token
}]]]></http:headers>
		</http:request>
		<ee:transform doc:name="Transform Message" doc:id="5336e828-51b0-4bb5-814b-7b82584758f5" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="trueUpRowsPayload" ><![CDATA[%dw 2.0
output application/json
var rows=if ((vars.rows) == 1) vars.rows + 1 else vars.rows + 2
var date=vars.date
var p1 = vars.freepointData.Products // here not extracted prods it means after getting inventory data
var p2 = vars.frpPurchasedSet

---
{
  values: p1 pluck ((v, k, i) ->
    do {
      var r = rows + i
      var qty1 = v."Quantity (bbls)"
      var qty2 = p2[k] default null
      var key = upper(trim(k as String))

      var formula =
        if (key contains "CRUDE")
          "=D" ++ r ++ "+" ++ "C" ++ r
        else
          "=D" ++ r ++ "-" ++ "C" ++ r

      ---
      [ date, k, qty1,qty2, formula ]
    }
  ) ++ [["","","","",""]]
}]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<http:request method="POST" doc:name="add rows to trueup" doc:id="f241f60c-ad12-4752-805a-168d3af502d5" url='#["https://graph.microsoft.com/v1.0/drives/2094b369-dbb6-4fd0-afd9-3e78830f8e98/items/" ++ vars.itemId ++ "/workbook/worksheets/trueup/tables/trueupTable/rows/add"]'>
			<http:body ><![CDATA[#[vars.trueUpRowsPayload]]]></http:body>
			<http:headers ><![CDATA[#[output application/java
---
{
	"Authorization" : "Bearer" ++ vars.token
}]]]></http:headers>
		</http:request>
