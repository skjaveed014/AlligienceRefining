		<ee:transform doc:name="Transform Message" doc:id="920d4d66-2901-42ba-bc3b-22e0a33f61c1" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="frpPurchasedSet" ><![CDATA[%dw 2.0
output application/json

var keys = vars.prods[1 to -1] map $[0]
var values = vars.quantity[1 to -1] map $[0]

---
(keys zip values) reduce ((item, acc = {}) -> acc ++ { (item[0]): item[1] })
]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<http:request method="GET" doc:name="get trueup rowcount" doc:id="293b9890-f8ba-4654-a1ff-c915bdaa84b4" url='#["https://graph.microsoft.com/v1.0/users/jshaik@mdwhub.com/drive/items/" ++ vars.itemId ++ "/workbook/worksheets/trueup/usedRange(valuesOnly=true)/rowCount"]' target="rows" targetValue="#[payload.value]">
			<http:headers ><![CDATA[#[output application/java
---
{
	"Authorization" : "Bearer" ++ vars.token
}]]]></http:headers>
		</http:request>
		<ee:transform doc:name="Transform Message" doc:id="5336e828-51b0-4bb5-814b-7b82584758f5" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="trueUpRowsPayload" ><![CDATA[%dw 2.0
output application/json
 
var rows = if (vars.rows == 1) 2 else vars.rows + 3
var date = vars.date
var p1 = vars.freepointData.Products
var p2 = vars.frpPurchasedSet
 
var header = [
    "Date",
    "Product",
    "T-SAR Inventory",
    "Freepoint Purchased",
    "Difference"
]
 
---
{
  values:
      [header] ++                              // Add header first
      (
        p1 pluck ((v, k, i) -> do {
            var r = rows + i
            var qty1 = v."Quantity (bbls)"
            var qty2 = p2[k] default null
            var key = upper(trim(k as String))
 
            var formula =
              if (key contains "CRUDE")
                "=D" ++ r ++ "+" ++ "C" ++ r
              else
                "=D" ++ r ++ "-" ++ "C" ++ r
 
            ---
            [ date, k, qty1, qty2, formula ]
        })
      )
}
 ]]></ee:set-variable>
				<ee:set-variable variableName="tableName" ><![CDATA["trueup_" ++ (vars.date replace "-" with "_")]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<set-variable value='#[%dw 2.0&#10;output application/json&#10;&#10;---&#10;if (vars.rows == 1)&#10;&#10;    {&#10;        range: "A1:" ++ "E" ++ (sizeOf(vars.prods) - 3)&#10;    }&#10;&#10;else&#10;&#10;    {&#10;        range: &#10;            "A" ++ (vars.rows + 2) &#10;            ++ ":" &#10;            ++ "E" ++ (vars.rows + 1 + (sizeOf(vars.prods) - 3))&#10;    }]' doc:name="Set Variable" doc:id="b537a0be-328b-40fd-ac4e-908eb75a2625" variableName="trueUpRange"/>
		<try doc:name="Try" doc:id="6841d0a3-0e2f-46dd-9124-005f61b701ef" >
			<http:request method="GET" doc:name="get " doc:id="ab0ba61b-85ea-488d-ac18-9a0fa0735a83" config-ref="HTTP_Graph_API_configuration" path="#[&quot;/v1.0/users/&quot; ++ p('graphApi.emailId') ++ &quot;/drive/items/&quot; ++ vars.itemId ++ &quot;/workbook/worksheets/trueup/tables/&quot; ++ vars.tableName]">
				<http:headers ><![CDATA[#[output application/java
---
{
	"Authorization" : "Bearer" ++ vars.token
}]]]></http:headers>
			</http:request>
			<set-variable value="update" doc:name="flag=update" doc:id="6a726aad-e33d-4f99-8d62-3b34ff9c20a0" variableName="flag" />
			<set-variable value="#[payload.id]" doc:name="columnId to update" doc:id="bb24a0e4-c06b-43c2-b2b5-4207b8fe8bde" variableName="columnId" />
			<error-handler >
				<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="96586f50-b027-453a-83dc-af705ad74ca7" type="HTTP:NOT_FOUND" >
					<logger level="INFO" doc:name="Logger" doc:id="8e2d6fde-6994-4a6e-835c-4701d639b553" message="-----ItemNotFound--------" />
					<set-variable value="insert" doc:name="flag=insert" doc:id="14ee4868-31f3-432e-918c-872adb195635" variableName="flag" />
				</on-error-continue>
			</error-handler>
		</try>
		<choice doc:name="Choice" doc:id="bafc442b-91d1-4599-890f-5abf8cadf5cc" >
			<when expression='#[vars.flag == "insert"]'>
				<http:request method="PATCH" doc:name="add rows to trueup" doc:id="f241f60c-ad12-4752-805a-168d3af502d5" url="#[&quot;https://graph.microsoft.com/v1.0/users/jshaik@mdwhub.com/drive/items/&quot; ++ vars.itemId ++ &quot;/workbook/worksheets/trueup/range(address='&quot; ++ vars.trueUpRange.range ++ &quot;')&quot;]">
			<http:body><![CDATA[#[vars.trueUpRowsPayload]]]></http:body>
			<http:headers><![CDATA[#[output application/java
---
{
