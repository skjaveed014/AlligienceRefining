		<http:request method="GET" doc:name="get quantity" doc:id="b9c235d4-95f1-4a1b-a249-c8263d99dac6" url='#["https://graph.microsoft.com/v1.0/users/jshaik@mdwhub.com/drive/items/"++ vars.itemId ++"/workbook/worksheets/Daily/tables/" ++ vars.tableName ++ "/columns/Quantity(bbls)"]' target="quantity" targetValue="#[payload.values]">
