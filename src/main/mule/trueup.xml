		<http:request method="GET" doc:name="get quantity" doc:id="b9c235d4-95f1-4a1b-a249-c8263d99dac6" url='#["https://graph.microsoft.com/v1.0/drives/2094b369-dbb6-4fd0-afd9-3e78830f8e98/items/"++ vars.itemId ++"/workbook/worksheets/Sheet1/tables/" ++ vars.tableName ++ "/columns/Quantity(bbls)"]' target="quantity" targetValue="#[payload.values]">
