					<ee:message />
					<ee:variables >
						<ee:set-variable variableName="newTanksTemplate" ><![CDATA[%dw 2.0
output application/json
var tanks = vars."newTanks"
var productsdata = vars."filteredTisData"."Products"
var colCount= vars.tisColumnCount
---
{	index: vars."NewProductRowIndex",
    values: tanks map (t) -> do {
        var product = flatten(
            productsdata pluck ((items, key) ->
                (items filter ((i) -> i.Tank == t)) map ((i) -> key)
            )
        )
        ---
        [t, if (sizeOf(product) > 0) product[0] else ""] 
        ++ (0 to (colCount - 2 - 1) map ((i) -> "0.0"))
    }
}]]></ee:set-variable>
