		<ee:transform doc:name="tis-request-data" doc:id="e4d075dd-d2d6-4486-b240-a2e07f85bd15" >
			<ee:message />
			<ee:variables >
				<ee:set-variable variableName="tis-request-data" ><![CDATA[%dw 2.0
output application/json
var template = flatten(vars."tis-template"."Tanks")
var data = vars."filtered-tis-data"."Products"
var date= vars."InventoryDate" as Date {format: "dd-MMM-yyyy"}

var coldata= {
    "values":  template map (t) -> do {
    // Remove this line → var tank = t[0]
    var match = flatten(
        data pluck ((v, k) ->
            (v filter (item) -> item.Tank == t) map ((item) -> item.GrossProduct)
        )
    ) filter ((item) -> item != null)
    ---
    if (sizeOf(match) > 0) [match[0]] else ["0.0"]
}
}

---
values: [[date]] ++ coldata.values ++ [[""],[""],[vars."changed-formulas".values[0][0]], [vars."changed-formulas".values[1][0]]]]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
