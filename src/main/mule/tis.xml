		<ee:transform doc:name="tisRequestData" doc:id="e4d075dd-d2d6-4486-b240-a2e07f85bd15" >
			<ee:message />
			<ee:variables >
				<ee:set-variable variableName="tisRequestData" ><![CDATA[%dw 2.0
output application/json
var template = flatten(vars."tisTemplate"."Tanks")
var data = vars."filteredTisData"."Products"
var date= vars."inventoryDate" as Date {format: "d-MMM-yyyy"}

var coldata= {
    "values":  template map (t) -> do {
    // Remove this line → var tank = t[0]
    var match = flatten(
        data pluck ((v, k) ->
            (v filter (item) -> item.Tank == t) map ((item) -> item.GrossProduct)
        )
    ) filter ((item) -> item != null)
    ---
    if (sizeOf(match) > 0) [match[0]] else ["0.0"]
}
}

---
values: [[date]] ++ coldata.values ++ [[""],[""],[vars."replacedFormulas".values[0][0]], [vars."replacedFormulas".values[1][0]]]]]></ee:set-variable>
			</ee:variables>
