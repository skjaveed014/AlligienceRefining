		<ee:transform doc:name="columnCountAndExcelColumn" doc:id="6b14dfab-3f65-43f7-a4b2-c1e97d0cbd8f" >
			<ee:message />
			<ee:variables >
				<ee:set-variable variableName="columnCountAndExcelColumn" ><![CDATA[%dw 2.0
output application/json

var columnCount = if (vars.flag == "update") vars.columnId else vars.tisColumnCount
var nextColumnCount = columnCount + 1
var preColumnCount = columnCount - 1
var letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

fun toExcelColumn(n) =
    if (n <= 0) "" 
    else do {
        var rem = (n - 1) mod 26
        var quotient = floor((n - 1) / 26)
        ---
        toExcelColumn(quotient) ++ (letters[rem to rem])
    }

---
{ 
  Number: columnCount,
  CurrentColumn: toExcelColumn(columnCount),
  NextColumn: toExcelColumn(nextColumnCount),
  PreviousColumn: toExcelColumn(preColumnCount)
}
]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
