		<ee:transform doc:name="columnCountAndExcelColumn" doc:id="6b14dfab-3f65-43f7-a4b2-c1e97d0cbd8f" >
			<ee:message />
			<ee:variables >
				<ee:set-variable variableName="columnCountAndExcelColumn" ><![CDATA[%dw 2.0
output application/json
var columnCount= payload."value"
var letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

fun toExcelColumn(n) =
    if (n <= 0) "" 
    else do {
        var rem = (n - 1) mod 26
        var quotient = floor((n - 1) / 26)
        ---
        toExcelColumn(quotient) ++ letters[(rem) as Number]
    }

---
{ 
  PresentColumnNumber: columnCount,
  PresentColumn: toExcelColumn(columnCount),
  NextColumnNumber: columnCount +1 ,
  NextColumn: toExcelColumn(columnCount + 1)
}]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<http:request method="GET" doc:name="get tank template column index=" doc:id="32da6544-23a2-4894-9ab7-83eabc0a39c1" config-ref="HTTP_Graph_API_configuration" path="#[&quot;/v1.0/users/&quot; ++ p('graphApi.emailId') ++ &quot;/drive/items/&quot; ++ p('workbook.tis.workbookId') ++ &quot;/workbook/tables/&quot; ++ p('tis.tableName') ++ &quot;/columns/itemAt(index=0)/range&quot;]" >
			<http:headers ><![CDATA[#[output application/json
---
{
	"Authorization" : "Bearer "++ vars."token" as String
}]]]></http:headers>
		</http:request>
		<ee:transform doc:name="payload" doc:id="93e59e3a-8c9d-44d8-9e87-28b5b7c9e78f" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
payload.text]]></ee:set-payload>
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="changed-formulas" ><![CDATA[%dw 2.0
output application/json

var from1 = "A"
var flag= vars.flag
var nextCol = vars.columnCountAndExcelColumn.NextColumn
var presentCol = vars.columnCountAndExcelColumn.PresentColumn
var data = payload.formulas[sizeOf(payload.formulas)-2 to sizeOf(payload.formulas)-1]

---
{
  values: data map ((row) ->
  if(flag=="update")
    row map ((cell) ->
      if (cell is String and sizeOf(cell) > 0 and cell[0] == "=")
        cell replace (("(?:" ++ from1 ++ ")(?=\\d|\\\$)") as Regex) with presentCol
      else cell
    )
    else row map ((cell) ->
      if (cell is String and sizeOf(cell) > 0 and cell[0] == "=")
        cell replace (("(?:" ++ from1 ++ ")(?=\\d|\\\$)") as Regex) with nextCol
      else cell
    )
  )
}]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="calling variables flow" doc:id="2bdb1891-51d8-493f-ba19-074d1f65ba94" name="variables" />
		<choice doc:name="checks for the new tanks" doc:id="46fb1407-123d-44e2-bba1-59f8f02bfb63" >
			<when expression='#[sizeOf(vars."new-tanks") &gt; 0]' >
				<ee:transform doc:name="new-tanks-template" doc:id="03abcab4-d1aa-492e-bfa9-d15455d15e29" >
					<ee:message />
					<ee:variables >
						<ee:set-variable variableName="new-tanks-template" ><![CDATA[%dw 2.0
output application/json
var tanks = vars."new-tanks"
var productsdata = vars."filtered-tis-data"."Products"
var colCount= payload."value"
---
{	index: vars."row-index",
    values: tanks map (t) -> do {
        var product = flatten(
            productsdata pluck ((items, key) ->
                (items filter ((i) -> i.Tank == t)) map ((i) -> key)
            )
        )
        ---
        [t, if (sizeOf(product) > 0) product[0] else ""] 
        ++ (0 to (colCount - 2 - 1) map ((i) -> "0.0"))
    }
}]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
				<http:request method="POST" doc:name="adds new tanks template to table" doc:id="f7904cc8-40ef-4e9f-b9b0-1947ec767e44" config-ref="HTTP_Graph_API_configuration" path="#[&quot;/v1.0/users/&quot; ++ p('graphApi.emailId') ++ &quot;/drive/items/&quot; ++ p('workbook.tis.workbookId') ++ &quot;/workbook/tables/&quot; ++ p('workbook.tis.workbookId') ++ &quot;/rows/add&quot;]" >
					<http:body ><![CDATA[#[vars."new-tanks-template"]]]></http:body>
					<http:headers ><![CDATA[#[output application/json
---
{
	"Authorization" : "Bearer "++ vars."token" as String
}]]]></http:headers>
				</http:request>
				<set-variable value='#[Tanks: vars."tis-template".Tanks ++ [vars."new-tanks"]]' doc:name="adding new-tanks-to-tis-template" doc:id="93491357-5d87-4916-85a1-d1d796b3231c" variableName="tis-template" />
			</when>
			<otherwise >
				<logger level="INFO" doc:name="Logger" doc:id="1173676f-6706-4bf3-b82f-dd4db3763797" message="----No New Tanks-----" />
