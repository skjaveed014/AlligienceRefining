		<ee:transform doc:name="var tisProductsColumn, replacedFormulas" doc:id="93e59e3a-8c9d-44d8-9e87-28b5b7c9e78f" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="replacedFormulas" ><![CDATA[%dw 2.0
output application/json

var from1 = "A"
var flag= vars.flag
var nextCol = vars.columnCountAndExcelColumn.NextColumn
var presentCol = vars.columnCountAndExcelColumn.CurrentColumn
var data = payload.formulas[sizeOf(payload.formulas)-2 to sizeOf(payload.formulas)-1]

---
{
  values: data map ((row) ->
  if(flag=="update")
    row map ((cell) ->
      if (cell is String and sizeOf(cell) > 0 and cell[0] == "=")
        cell replace (("(?:" ++ from1 ++ ")(?=\\d|\\\$)") as Regex) with presentCol
      else cell
    )
    else row map ((cell) ->
      if (cell is String and sizeOf(cell) > 0 and cell[0] == "=")
        cell replace (("(?:" ++ from1 ++ ")(?=\\d|\\\$)") as Regex) with nextCol
      else cell
    )
  )
}]]></ee:set-variable>
				<ee:set-variable variableName="tisProductsColumn" ><![CDATA[%dw 2.0
output application/json
---
payload.text]]></ee:set-variable>
