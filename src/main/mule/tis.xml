		<ee:transform doc:name="tis-raw-data in key and value pair" doc:id="c6044e68-3452-4c27-a567-113ec4ff46fd">
			<ee:message />
			<ee:variables>
				<ee:set-variable variableName="tis-raw-data"><![CDATA[%dw 2.0
output application/json
var products= vars."tis-product-column"
var data = vars."tis-values"
---
(products[1 to sizeOf(products) - 1] map ((p, i) ->
    {(p[0]): data[i + 1][0]}
)) reduce ((acc, item) -> acc ++ item)]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<ee:transform doc:name="aggregated-tis-data(tis)" doc:id="ff08a78c-77cb-4201-8c0b-55c5f45a8260">
			<ee:message />
			<ee:variables>
				<ee:set-variable variableName="aggregated-tis-data"><![CDATA[%dw 2.0
output application/json
---
(vars."tis-raw-data" pluck (v, k) -> {
  Product: k,
  value: if (v is String and v == "-") 0 else (v as Number default 0)
})
groupBy $.Product
mapObject ((arr, key) -> (key): ((arr map $.value) reduce ($$ + $) default 0))]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
