		<http:request method="GET" doc:name="gets column count" doc:id="e5535d76-d20b-4834-969a-d65f87453341" config-ref="HTTP_Graph_API_configuration" path="#[&quot;/v1.0/users/&quot; ++ p('graphApi.emailId') ++ &quot;/drive/items/&quot; ++ p('workbook.tis.workbookId') ++ &quot;/workbook/tables/&quot; ++ p('tis.tableName') ++ &quot;/columns/count&quot;]" >
