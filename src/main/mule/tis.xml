			<ee:message />
			<ee:variables>
				<ee:set-variable variableName="aggregatedTisData" ><![CDATA[%dw 2.0
output application/json
---
(vars."tisRawData" pluck (v, k) -> {
  Product: k,
  value: if (v is String and v == "-") 0 else (v as Number default 0)
})
groupBy $.Product
mapObject ((arr, key) -> (key): ((arr map $.value) reduce ($$ + $) default 0))]]></ee:set-variable>
			
