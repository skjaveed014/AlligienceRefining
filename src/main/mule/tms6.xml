&#45;&#45;-
{
	"Authorization" : "Bearer " ++ vars.token
}&#93;&#93;&#93;></http:headers>
		</http:request> [STUDIO] -->
		<ee:transform doc:name="stockholdersPDFData" doc:id="71e8c06d-133a-469a-8df4-979b8d97fb80" >
			<ee:message />
			<ee:variables >
				<ee:set-variable variableName="exportStockHoldersFromLookUp" ><![CDATA[vars."stockholderLookupValues"
    filter ((item) -> (item.values[0] contains "Export"))
    map ((item) -> item.values[0][0])]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<ee:transform doc:name="var exportsData" doc:id="0e450a00-6ffc-4d64-b1aa-9925b6b9b1ae" >
			<ee:message />
			<ee:variables >
				<ee:set-variable variableName="exportsData" ><![CDATA[%dw 2.0
output application/json
//  exported data by stockholders lookup names


var exportStockHoldersFromLookUp = vars.exportStockHoldersFromLookUp
var stockholdersPDFData = vars.tms6Data.StockHolders

// Extract only the stockholder name part, cleaned
fun cleanName(name) =
    trim((trim(name) splitBy " ")[2 to -1] joinBy " ")

---
stockholdersPDFData[0]
    filterObject ((value, key) ->
        sizeOf(
            exportStockHoldersFromLookUp filter ((exp) ->
                upper(cleanName(exp)) == upper(trim(key))
            )
        ) > 0
    )
]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<ee:transform doc:name="var exportTankSetData" doc:id="fbdcee56-3f41-444d-886d-ed1b12fbc954" >
			<ee:message />
			<ee:variables >
				<ee:set-variable variableName="exportTankSetData" ><![CDATA[%dw 2.0
output application/json
---
flatten(
    vars.exportsData pluck ((value, key) ->
        value map ((item) -> {
            stockholder: key,
            tank: item.tank,
            productName: item.productName,
            volume: item.volume
        })
    )
)
]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<ee:transform doc:name="var exportTanks" doc:id="2bbb40a3-e1f7-4c92-b4df-b0baa4428162" >
			<ee:message />
			<ee:variables >
				<ee:set-variable variableName="exportTanks" ><![CDATA[%dw 2.0
output application/json
---
vars.exportTankSetData
    groupBy ((item) -> item.tank)
    pluck ((tankGroup, tankId) -> {
        tank: tankId,
        productName: (tankGroup[0].productName), // same product name for all same-tank items
        volume: (tankGroup.*volume map ((v) -> v as Number)) reduce ((a, b) -> a + b)
    })
]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
	</sub-flow>
