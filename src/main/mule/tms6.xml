output application/json
---
"/v1.0/users/" ++ p('graphApi.emailId') ++ "/drive/items/" ++ vars.inventoryAndSalesWorkbookId ++ "/workbook/tables/" ++ vars.tableName ++ "/rows/add"]]></ee:set-variable>
