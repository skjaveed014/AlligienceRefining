					</ee:message>
					<ee:variables >
						<ee:set-variable variableName="vmethod" ><![CDATA["GET"]]></ee:set-variable>
						<ee:set-variable variableName="vpath" ><![CDATA[%dw 2.0
output application/json
---
"/v1.0/users/" ++ p('graphApi.emailId') ++ "/drive/items/" ++ vars.inventoryAndSalesWorkbookId ++ "/workbook/tables/" ++ vars.tableName ++ "/columns/count"]]></ee:set-variable>
						<ee:set-variable variableName="vpayload" ><![CDATA[""]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
				<flow-ref doc:name="tms6-common-requestor-Sub_Flow" doc:id="5d55417e-7289-4e30-a7c6-826849f6486f" name="tms6-common-requestor-Sub_Flow"/>
				<set-variable value="#[payload.value]" doc:name="tms6ColumnCount" doc:id="c1ce3833-8e30-4c75-abc5-a7ec9921fd25" variableName="tms6ColumnCount"/>
				<!-- [STUDIO:"get tms6 column count"]<http:request method="GET" doc:name="get tms6 column count" doc:id="e96e958e-3ce7-49e3-971c-05534927fd81" config-ref="HTTP_Graph_API_configuration" path="#[&quot;/v1.0/users/&quot; ++ p('graphApi.emailId') ++ &quot;/drive/items/&quot; ++ vars.inventoryAndSalesWorkbookId ++ &quot;/workbook/tables/&quot; ++ vars.tableName ++ &quot;/columns/count&quot;&#93;" target="columnCount" targetValue="#[payload.value&#93;" >
					<http:body ><![CDATA[#[""&#93;&#93;&#93;></http:body>
					<http:headers ><![CDATA[#[output application/json
&#45;&#45;-
{
	"Authorization" : "Bearer" ++ vars.token
}&#93;&#93;&#93;></http:headers>
				</http:request> [STUDIO] -->
				<ee:transform doc:name="newTanks data in rows" doc:id="86d90685-66b7-41fc-8730-45c6e9383d8b" >
					<ee:message />
					<ee:variables >
						<ee:set-variable variableName="newTanksRowPayload" ><![CDATA[%dw 2.0
output application/json
// This gives output of the new products for the previous dates

// input
var newTanks = vars.newTanks

// total number of columns
var columnCount = vars.tms6ColumnCount

// main logic
---
(if (columnCount > 2)
    newTanks map ((item) ->
        [item.tank, item.productName] ++ (1 to (columnCount - 2) map ((n) -> "0"))
    )
else 
    newTanks map ((item) ->
        [item.tank, item.productName]
    )
)  map(item)-> {values:[item]}]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
				<foreach doc:name="For Each newTanksRowPayload" doc:id="48ae167b-73d4-4397-b453-a3a23cdd32f9" collection="#[vars.newTanksRowPayload]" >
					<set-variable value="#[vars.existTanks ++ [payload.values[0][0]]]" doc:name="add new tanks to existTanks" doc:id="e9e1396e-3c8c-41b2-8103-5ff996bde4d2" variableName="existTanks" />
					<ee:transform doc:name="vMethod and vPath to add new products row in TMS6" doc:id="f966e4db-624b-4bb9-bbf3-032dab5371cd" >
