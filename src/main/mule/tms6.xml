	<sub-flow name="tms6-subflow" doc:id="7335dae2-1d3d-4475-b5bd-e8351f2d92e7" >
		<set-variable value='#[vars."idpResponseData"."TMS6"]' doc:name="tms6Data" doc:id="fa09f694-65c1-4b2c-aceb-3e0c63bdc7f5" variableName="tms6Data"/>
		<ee:transform doc:name="var tms6TableNames, tanks" doc:id="25962717-0380-46dd-a252-80f154e27926">
			<ee:message />
			<ee:variables>
				<ee:set-variable variableName="tms6TableNames" ><![CDATA[[p('tms6.tableName'), p('tms6.receipts.tableName'), p('tms6.exports.tableName')]]]></ee:set-variable>
				<ee:set-variable variableName="tanks" ><![CDATA[%dw 2.0
output application/json
---
(vars.tms6Data.products default [])
    filter ((item) -> item != null)
    map ((item) -> item.tank)

]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<ee:transform doc:name="var receiptsData" doc:id="2802b919-a9c4-4b1c-b367-6f5580be546e" >
			<ee:message />
			<ee:variables >
				<ee:set-variable variableName="receiptsData" ><![CDATA[%dw 2.0
output application/json
---
[
	flatten(vars.tms6Data.products map ((item) -> 
    item.tank map ((t, i) -> {
        tank: t,
        productName: item.productName[i],
        volume: item.volume[i],
        stockAdjust: item.stockAdjust[i]
    })
)) filter ((p) -> p.stockAdjust != "0")
]]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<foreach doc:name="For Each tms6TableNames" doc:id="6b006ad6-0c33-406b-aa20-4729ce481390" collection="#[vars.tms6TableNames]" >
			<set-variable value="#[payload]" doc:name="tableName" doc:id="2c97a74d-219c-429a-94aa-e221ba79900d" variableName="tableName" />
			<choice doc:name="checks for exports table" doc:id="3418a464-f188-45cb-ad81-d4c0fa897d85" >
				<when expression='#[payload=="TMS6_Exports_Table"]' >
					<flow-ref doc:name="tms6-exports-data-subflow" doc:id="de9cb3e5-e791-483f-bf73-fc0bf996f64b" name="tms6-exports-data-subflow" />
				</when>
				<when expression='#[payload == "TMS6_Receipts_Table"]'>
					<flow-ref doc:name="tms6-receipts-data-sub-flow" doc:id="d9ce0aec-3aed-4ed1-880a-ce7254d73048" name="tms6-receipts-data-sub-flow"/>
				</when>
				<otherwise >
					<logger level="INFO" doc:name="Logger" doc:id="aba291f8-2bd6-44e0-8bbe-465002633ce0" />
				</otherwise>
			</choice>
			<ee:transform doc:name="respective table-data" doc:id="9d556373-a7c8-4cd5-9fd7-93ff59103d06" >
				<ee:message />
				<ee:variables >
					<ee:set-variable variableName="data" ><![CDATA[%dw 2.0
output application/json

// This transform message will take data either tms6Data or receipts data or exports data
---
if(vars.tableName != p('tms6.exports.tableName')) 
	(
		if(vars.tableName== p('tms6.tableName')) vars.tms6Data.products 
		else if(vars.tableName== p('tms6.receipts.tableName')) vars.receiptsData  
		else null 
		    filter ((item) -> item.stockAdjust != "0")
		    map ((p) -> {
		        tank: p.tank,
		        productName: p.productName,
		        volume:p.volume,
		        stockAdjust: p.stockAdjust
		    })
    )
    else [vars.exportTanks]

]]></ee:set-variable>
				</ee:variables>
			</ee:transform>
			<ee:transform doc:name="vMethod and vPath to get existTanks in TMS6" doc:id="5679f99f-4ea0-4a69-baad-3fd97073ca82" >
				<ee:message >
				</ee:message>
				<ee:variables >
					<ee:set-variable variableName="vpath" ><![CDATA[%dw 2.0
output application/json
---
"/v1.0/users/" ++ p('graphApi.emailId') ++ "/drive/items/" ++ vars.inventoryAndSalesWorkbookId ++ "/workbook/tables/" ++ vars.tableName ++ "/columns/1"]]></ee:set-variable>
					<ee:set-variable variableName="vpayload" ><![CDATA[""]]></ee:set-variable>
					<ee:set-variable variableName="vmethod" ><![CDATA["GET"]]></ee:set-variable>
				</ee:variables>
			</ee:transform>
			<flow-ref doc:name="tms6-common-requestor-Sub_Flow" doc:id="2e871cfb-e895-4036-8446-421a09225d7b" name="tms6-common-requestor-Sub_Flow"/>
			<set-variable value="#[flatten((payload.values) - (payload.values[0]))]" doc:name="existTanks" doc:id="715b29a6-a57f-4409-ab11-e647a679a96f" variableName="existTanks"/>
			<!-- [STUDIO:"gets existTanks "]<http:request method="GET" doc:name="gets existTanks " doc:id="83e5f17d-9495-4ba9-a408-142f5473cd6f" config-ref="HTTP_Graph_API_configuration" path="#[&quot;/v1.0/users/&quot; ++ p('graphApi.emailId') ++ &quot;/drive/items/&quot; ++ vars.inventoryAndSalesWorkbookId ++ &quot;/workbook/tables/&quot; ++ vars.tableName ++ &quot;/columns/1&quot;&#93;" target="existTanks" targetValue="#[flatten((payload.values) - (payload.values[0&#93;))&#93;" >
				<http:body ><![CDATA[#[""&#93;&#93;&#93;></http:body>
				<http:headers ><![CDATA[#[output application/json
&#45;&#45;-
{
	"Authorization" : "Bearer" ++ vars.token
}&#93;&#93;&#93;></http:headers>
			</http:request> [STUDIO] -->
			<ee:transform doc:name="var newTanks(came in TMS6 pdf)" doc:id="e13041e9-2817-4abb-8213-9fdee9fe4c03" >
				<ee:message />
				<ee:variables >
					<ee:set-variable variableName="newTanks" ><![CDATA[%dw 2.0
output application/json
// This will look for the new tanks came in pdfs with comparing to tms6 sheet
//var existTanks = vars.existTanks
---
vars.data[0] filter (p) -> not (vars.existTanks contains (p.tank as String))]]></ee:set-variable>
				</ee:variables>
			</ee:transform>
			<flow-ref doc:name="check-for-new-tanks-and-post-new-tanks-data-in-tms6-sheet-subflow" doc:id="7ce55dee-af37-4798-ae0d-b979315b9f35" name="check-for-new-tanks-and-post-new-tanks-data-in-tms6-sheet-subflow" />
			<flow-ref doc:name="tms6-post-subflow" doc:id="a43ce17e-0163-48b3-bc60-e071d38d767c" name="tms6-post-subflow" />
		</foreach>
