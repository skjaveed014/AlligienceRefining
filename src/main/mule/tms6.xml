					<!-- [STUDIO:"adding new product Row in tms6"]<http:request method="POST" doc:name="adding new product Row in tms6" doc:id="d5b769a4-2946-48b0-b19d-d7434b1f5854" config-ref="HTTP_Graph_API_configuration" path="#[&quot;/v1.0/users/&quot; ++ p('graphApi.emailId') ++ &quot;/drive/items/&quot; ++ vars.inventoryAndSalesWorkbookId ++ &quot;/workbook/tables/&quot; ++ vars.tableName ++ &quot;/rows/add&quot;&#93;" >
