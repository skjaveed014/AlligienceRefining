		<ee:transform doc:name="receipts stockholders lookup" doc:id="8353ee16-b4be-4a42-9def-97581915cbdd" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="receiptsStockholdersLookup" ><![CDATA[%dw 2.0
output application/json
---
vars.stockholderLookupValues
    filter ($.values[0] contains "Receipt")
    map {
        stockholder: $.values[0][0],
        product: $.values[0][1]
    }
]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<ee:transform doc:name="overeriding receiptsdata" doc:id="7e5066e8-1841-4c80-a102-803b8d12bd8e" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="receiptsData" ><![CDATA[%dw 2.0
output application/json

var input2 = vars.receiptsStockholdersLookup

// "000ETH ETHANOL BASE" -> "ETHANOL BASE"
fun trimProduct(p) =
    (p splitBy " ")[1 to -1] joinBy " "

---
[(
    flatten(vars.receiptsData)
)
filter ((item) ->
    sizeOf(
        input2
            filter ((s) ->
                upper(trimProduct(s.product))
                    == upper(item.productName)
            )
    ) > 0
)]]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
