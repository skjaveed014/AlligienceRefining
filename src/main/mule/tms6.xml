			<try doc:name="Try" doc:id="d214fdcd-eb2b-40bf-9b30-313c469b9e80">
			<set-variable value='#[null]' doc:name="httpErrorType" doc:id="28114543-777d-42fa-8056-08a2a9aa7957" variableName="httpErrorType" />
