---
{
	"Authorization" : "Bearer" ++ vars.token
}]]]></http:headers>
		</http:request>
				<error-handler>
					<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="dbb8c3e1-0018-435d-9329-3a6824c3e89e" type="HTTP:CONNECTIVITY, HTTP:TIMEOUT">
						<logger level="INFO" doc:name="Logger" doc:id="253751c7-a0d4-4222-a550-04269d7495fc" message="retring timeout error"/>
					</on-error-propagate>
					<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="a6ed0b27-38b2-4233-96ff-c4983b0c1224" type="ANY">
						<set-variable value="#[error.errorType.identifier]" doc:name="httpErrorType" doc:id="459715dd-655b-48c5-88fe-f5aa55251eb1" variableName="httpErrorType" />
					</on-error-continue>
			</error-handler>
		</try>
		</until-successful>
		<choice doc:name="Choice" doc:id="daef8245-a703-4f71-8c0b-b71438bad9a0" >
			<when expression='#[vars.httpErrorType == "NOT_FOUND"]' >
				<raise-error doc:name="Raise error" doc:id="f570f3fd-15ed-4cf6-8494-d6b6a225ed8a" type="HTTP1:NOT_FOUND" description="not found" />
			</when>
			<when expression="#[vars.httpErrorType != null]" >
				<raise-error doc:name="Raise error" doc:id="bc8e372b-27dd-4067-9309-b5dde6e72c90" type="APP:HTTP_REQUEST_FAILED" description="#['HTTP error: ' ++ (vars.httpErrorType default 'UNKNOWN')]" />
