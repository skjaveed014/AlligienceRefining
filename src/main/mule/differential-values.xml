		<http:request method="GET" doc:name="gets Sheet-names from lookup table" doc:id="f2971914-25e5-46b1-acda-df223bcc44b2" config-ref="HTTP_Graph_API_configuration" path="/v1.0/users/jshaik@mdwhub.com/drive/items/01NVG26FWFXVCMQY7BCNHIM4QFYVBNDEIQ/workbook/tables/ProductName_Lookup_Table/columns/2" target="lookupTableSheetNames" targetValue="#[payload.values]" >
			<http:body ><![CDATA[#[""]]]></http:body>
			<http:headers ><![CDATA[#[output application/json
---
{
	"Authorization" : "Bearer "++ vars."token" as String
}]]]></http:headers>
		</http:request>
		<ee:transform doc:name="productNameLlookup" doc:id="0bb3fa22-9e20-40b2-ab5c-ca58d277c978" >
			<ee:message />
			<ee:variables >
				<ee:set-variable variableName="productNamesLookup" ><![CDATA[%dw 2.0
output application/json
var diffNames= vars."lookupTableDiffNames"
var sheetNames= vars."lookupTableSheetNames"
---
(diffNames[1 to -1] map (item, index) -> {
    (item[0]): sheetNames[index + 1][0]
})
reduce ($$ ++ $)
]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
	</sub-flow>
</mule>
