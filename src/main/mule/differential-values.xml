		</http:request>
		<!-- [STUDIO:"month"]<set-variable value='#[vars."month-year"."month" ++ "-" ++ vars."month-year"."year"&#93;' doc:name="month" doc:id="5dae39dc-778e-40a2-b606-8ac9f38aead6" variableName="month" /> [STUDIO] -->
		<http:request method="GET" doc:name="gets montly diff values" doc:id="ddbbc7d3-854e-42bb-a71b-55dece83af38" config-ref="HTTP_Graph_API_configuration" path='#["/v1.0/users/jshaik@mdwhub.com/drive/items/01NVG26FWFXVCMQY7BCNHIM4QFYVBNDEIQ/workbook/tables/Differential_Table/columns/"++ vars.monthYear.month ++ "-" ++ vars.monthYear.year]' target="diffSheetValues" targetValue="#[payload.values]" >
			<http:body ><![CDATA[#[""]]]></http:body>
			<http:headers ><![CDATA[#[output application/json
---
{
	"Authorization" : "Bearer "++ vars."token" as String
}]]]></http:headers>
		</http:request>
		<ee:transform doc:name="actualDifferentialValues" doc:id="2b55f404-3806-4da8-a64b-cdb1ffb01a13" >
			<ee:message />
			<ee:variables >
				<ee:set-variable variableName="actualDifferentialValues" ><![CDATA[%dw 2.0
output application/json
var products= vars."diffSheetProductNames"
var values= vars."diffSheetValues"
var data=flatten(
    products map (p, index) ->
        (p[0] splitBy ",") map (item) ->
            {
                product: trim(item),
                value: values[index][0]
            }
) filter ((item, index) -> item.product !="")
---
(data map (item) ->
    {
        (item.product): item.value
    }
) reduce ($$++$)]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<ee:transform doc:name="differentialValuesByLookupWithLessRVO" doc:id="6c8ead75-9023-4700-adcf-c1cd38640ec9" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="differentialValuesByLookupWithLessRVO" ><![CDATA[%dw 2.0
output application/json
var lessRVO= vars.lessRVO
var differentialValues = vars.actualDifferentialValues
var lookupNamesForDiffValues= vars.productNamesLookup

fun findName(key)= lookupNamesForDiffValues[key]
var data =lookupNamesForDiffValues 
    mapObject ((value, key) -> 
        (value): differentialValues[key]
    )
var keysToRemove=["Gasoline - Export", "ULSHO - Export"]
var dataWithOutLessRVO= data -- keysToRemove
---
dataWithOutLessRVO ++ 
{
    "Gasoline - Export": data."Gasoline - Export" - lessRVO,
    "ULSHO - Export": data."ULSHO - Export" - lessRVO
}
]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
	</sub-flow>
